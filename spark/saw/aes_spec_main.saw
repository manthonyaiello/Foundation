/*
 * The AES spec layer's bit-vector interface, Foundation_Spark.AES.Spec.Main
 * (spark/src/aes/foundation_spark-aes-spec-main.ads): the splits of
 * algorithms/AES/Main.cry's Encrypt and Decrypt and their join; and
 * Main.cry's AES`{k} itself, the Split_Key, Encrypt and Decrypt of the
 * instances AES128, AES192 and AES256 of the generic AES_K, at
 * k = 128, 192 and 256. Included by aes_spec.saw after the other
 * aes_spec_*.saw files, whose lemmas it uses.
 *
 * Main.cry's bit sequences [n] are the spec's ghost Boolean arrays Bits,
 * indexed by Bit_Index, range 0 .. 256, a 16-bit integer (Object_Size 16;
 * README "The bitcode ABI"): an Ada Boolean
 * is a byte, 0 or 1, so a [n] is n bytes, each holding one bit, the
 * Cryptol's first (most significant) bit first. The contracts take the
 * bytes as fresh variables under the precondition that each is 0 or 1
 * (the validity of an Ada Boolean), and read them as Cryptol bits with
 * bits_of. Unconstrained bit sequences (the key) are fat pointers whose
 * bounds record is two i16, {First, Last}; Block_Bits, Bits (0 .. 127),
 * is passed by reference.
 *
 * Bit_Index is 16-bit, so these contracts say i16, not i128. The i16
 * is read from GNAT-LLVM 27's IR (2026-10-21): bits_BOUNDS is { i16, i16 }
 * and Byte_At's From an i16, as Bit_Index'Object_Size gives.
 */

let bits_bounds_t = llvm_alias "foundation_spark__aes__spec__main__bits_BOUNDS";
/* Bit_Index's width in the bitcode. */
let bit_index_t = llvm_int 16;
let bits_t (n : Int) = llvm_array n byte_t;

/* Bytes, each 0 or 1, as Cryptol bits. */
let bits_of = {{ \bs -> [ b == (1 : [8]) | b <- bs ] }};

/*
 * n bytes, each 0 or 1, read-only: an Ada Bits of length n.
 */
let fresh_bits (name : String) (n : Int) = do {
  bs <- llvm_fresh_var name (bits_t n);
  llvm_precond {{ all (\b -> b <= 1) bs }};
  p <- llvm_alloc_readonly (bits_t n);
  llvm_points_to p (llvm_term bs);
  return (bs, p);
};

/*
 * A fat pointer to n bits with bounds {0, n - 1} (i16), read-only.
 */
let fresh_bits_fp (name : String) (n : Int) = do {
  (bs, p) <- fresh_bits name n;
  b <- llvm_alloc_readonly bits_bounds_t;
  llvm_points_to b (llvm_struct_value [llvm_term {{ 0 : [16] }}, llvm_term {{ `n - 1 : [16] }}]);
  return (bs, llvm_struct_value [p, b]);
};

/* --- the bit-level helpers ---------------------------------------------- */

/*
 * Bit_Of (B, J) = b @ j (Cryptol's join places byte i's bit j at 8 i + j),
 * for every J in 0 .. 7.
 */
m_bit_of <- verify_spec "main__bit_of" []
              (do {
                 b <- llvm_fresh_var "b" byte_t;
                 j <- llvm_fresh_var "j" (llvm_int 32);
                 llvm_precond {{ j < 8 }};
                 llvm_execute_func [llvm_term b, llvm_term j];
                 llvm_return (llvm_term {{ if b @ j then 1 else 0 : [8] }});
               }) z3 "z3" "\\b j -> b @ j, j < 8";

/*
 * Byte_At (Bs, From) = the [8] at bits From .. From + 7 of Bs, which
 * Cryptol's split takes as one byte: take`{8} (bs << from), at the
 * lengths it is called at (128, 192, 256), From symbolic.
 */
let verify_byte_at (n : Int) =
  verify_spec "main__byte_at" []
    (do {
       (bs, fp) <- fresh_bits_fp "bs" n;
       from <- llvm_fresh_var "from" bit_index_t;
       llvm_precond {{ from <= `n - 8 }};
       llvm_execute_func [fp, llvm_term from];
       llvm_return (llvm_term {{ take`{8} ((bits_of bs) << from) }});
     }) z3 "z3" (str_concat (str_concat "\\bs from -> take`{8} (bs << from), bs : [" (show n)) "]");
m_byte_at_128 <- verify_byte_at 128;
m_byte_at_192 <- verify_byte_at 192;
m_byte_at_256 <- verify_byte_at 256;

/*
 * Split_Block = Main.cry's split in : [128] -> Block. It calls
 * the prelude's Byte_Bits.Split_At (Join_Split, which calls its Value),
 * not Byte_At, so SAW executes those at each concrete byte index and no
 * override applies.
 */
m_split_block <- verify_spec "main__split_block" []
                   (do {
                      (bs, p) <- fresh_bits "bs" 128;
                      llvm_execute_func [p];
                      llvm_return (llvm_term {{ split (bits_of bs) : [16][8] }});
                    }) z3 "z3" "split : [128] -> Block";

/*
 * Join_Block = Main.cry's join : Block -> [128] (Encrypt's and Decrypt's
 * join). Block_Bits, constrained, is returned through a pointer to the
 * caller's [128 x i8] (sret). While Bit_Index was 128-bit, Join_Block's
 * aggregate indexed its temporary with an i128 GEP index, which SAW 1.6
 * rejects ("Invalid index value in GEP"), and check-saw.sh rewrote it
 * (gep64). The narrow Bit_Index retired the rewrite; Join_Block no
 * longer indexes anything itself.
 *
 * Join_Block is the prelude's Byte_Bits.Join (Join_Split) of the
 * block, which returns an unconstrained Bits on the secondary stack, that
 * Join_Block copies into the caller's [128]; Join reads bits through
 * Word_Bits.Bit, not Bit_Of, so no override applies. GNAT-LLVM 27
 * (2026-10-21): Join_Block marks the secondary stack, calls Join, which
 * allocates its {i16, i16} bounds and 128 bits (132 bytes, ss_size 4
 * 128 = 144), memcpys the bits out, and releases the mark. So the stack
 * is left as found, empty, but its High_Water_Mark is the larger of the
 * one found, hwm (symbolic; at most the chunk's size, so that the
 * runtime's signed comparison is the unsigned one), and 144: Encrypt calls Join_Block on a
 * fresh stack, Decrypt after InvCipher has left its own mark (rv_size).
 */
let join_block_hwm = ss_size 4 128;
m_join_block <- verify_spec "main__join_block" []
                  (do {
                     hwm <- llvm_fresh_var "hwm" (llvm_int 64);
                     llvm_precond {{ hwm <= `ss_chunk_size }};
                     stack <- secondary_stack_hwm 0 hwm;
                     b <- llvm_fresh_var "b" block_t;
                     ret <- llvm_alloc (bits_t 128);
                     llvm_execute_func [ret, llvm_term b];
                     ss_post_hwm_t stack 0 {{ if hwm < `join_block_hwm then `join_block_hwm else hwm }};
                     llvm_points_to ret (llvm_term {{ [ if x then 1 else 0 | x <- join b ] : [128][8] }});
                   }) z3 "z3" "join : Block -> [128], any High_Water_Mark";

/* --- the instances of AES_K: Main.cry's AES`{k} -------------------------- */

/*
 * AES<k>.Split_Key (Key) = Main.cry's split (split key) : [Nk k]AESWord,
 * at k = 128, 192, 256 (the generic AES_K's, with no K argument).
 * Key, of the instance's constrained Key_Bits (0 .. K - 1), is a pointer
 * to k bits with no bounds. The result, of the constrained Key_Words, is
 * returned BY VALUE at every k ([4|6|8 x [4 x i8]], GNAT-LLVM 27,
 * 2026-10-21; not through sret at 192 and 256, as first assumed).
 * It reads each byte with the prelude's Byte_Bits.Split_At, not Byte_At,
 * so no override applies; SAW executes Split_At and its Value.
 */
let verify_split_key (k : Int) (nk : Int) =
  verify_spec (instance_symbol k "split_key") []
    (do {
       (key, kp) <- fresh_bits "key" k;
       llvm_execute_func [kp];
       llvm_return (llvm_term {{ split (split (bits_of key)) : [nk][4][8] }});
     }) z3 "z3" (str_concat (str_concat "split (split key) : [" (show k)) "] -> [Nk k]AESWord");
m_split_key_128 <- verify_split_key 128 4;
m_split_key_192 <- verify_split_key 192 6;
m_split_key_256 <- verify_split_key 256 8;

/*
 * AES<k>.Encrypt (Key, Input) and AES<k>.Decrypt (Key, Input) = Main.cry's
 * AES`{k}.Encrypt key in and AES`{k}.Decrypt key in [FIPS-PUB-197
 * Section 5] (Main.cry:21-24): join (Cipher`{k} (KeyExpansion`{k}
 * (split (split key))) (split in)), and InvCipher for Decrypt. These are
 * Main.cry's AES128.Encrypt and the others (Main.cry:43-55), since the
 * instance AES128 of AES_K is Main.cry's AES128 = AES`{128}, and
 * likewise at 192 and 256.
 * Key is a pointer to k bits (the constrained Key_Bits), Input a
 * pointer to 128, the result written
 * through the caller's pointer. Split_Key's and KeyExpansion's results
 * are constrained, so they live in stack temporaries. Neither function
 * marks the secondary stack itself, but both reach it (GNAT-LLVM 27,
 * 2026-10-21): Encrypt through Join_Block, which leaves it empty with its
 * High_Water_Mark at join_block_hwm; Decrypt through InvCipher, which
 * leaves it empty with its High_Water_Mark at rv_size nr (larger), and
 * then Join_Block, which leaves that unchanged. The overrides are the lemmas of each call at k; z3 leaves Cipher, InvCipher
 * and KeyExpansion uninterpreted.
 */
let main_unint = ["Cipher", "InvCipher", "KeyExpansion"];
let main_unint_name = "w4_unint_z3 Cipher InvCipher KeyExpansion";
let main_contract (k : Int) (ss : Bool) (hwm : Int) (f : Term) = do {
  stack <- if ss then secondary_stack else return llvm_null;
  (key, kp) <- fresh_bits "key" k;
  (input, ip) <- fresh_bits "input" 128;
  ret <- llvm_alloc (bits_t 128);
  llvm_execute_func [ret, kp, ip];
  if ss then ss_post_hwm stack 0 hwm else return ();
  llvm_points_to ret (llvm_term {{ [ if x then 1 else 0 | x <- f (bits_of key) (bits_of input) ] : [128][8] }});
};
let verify_encrypt (k : Int) (nr : Int) (split_key : LLVMSpec) (ke : LLVMSpec) (cipher : LLVMSpec) =
  verify_spec (instance_symbol k "encrypt") [split_key, ke, m_split_block, cipher, m_join_block]
    (main_contract k true join_block_hwm {{ (AES`{k}).Encrypt }})
    (w4_unint_z3 main_unint) main_unint_name
    (str_concat (str_concat (str_concat (str_concat "Main::AES`{" (show k)) "}.Encrypt (Main::AES") (show k)) ".Encrypt)");
let verify_decrypt (k : Int) (nr : Int) (split_key : LLVMSpec) (ke : LLVMSpec) (invcipher : LLVMSpec) =
  verify_spec (instance_symbol k "decrypt") [split_key, ke, m_split_block, invcipher, m_join_block]
    (main_contract k true (rv_size nr) {{ (AES`{k}).Decrypt }})
    (w4_unint_z3 main_unint) main_unint_name
    (str_concat (str_concat (str_concat (str_concat "Main::AES`{" (show k)) "}.Decrypt (Main::AES") (show k)) ".Decrypt)");
m_encrypt_128 <- verify_encrypt 128 10 m_split_key_128 ke_keyexpansion_128 c_cipher_128;
m_encrypt_192 <- verify_encrypt 192 12 m_split_key_192 ke_keyexpansion_192 c_cipher_192;
m_encrypt_256 <- verify_encrypt 256 14 m_split_key_256 ke_keyexpansion_256 c_cipher_256;
m_decrypt_128 <- verify_decrypt 128 10 m_split_key_128 ke_keyexpansion_128 c_invcipher_128;
m_decrypt_192 <- verify_decrypt 192 12 m_split_key_192 ke_keyexpansion_192 c_invcipher_192;
m_decrypt_256 <- verify_decrypt 256 14 m_split_key_256 ke_keyexpansion_256 c_invcipher_256;

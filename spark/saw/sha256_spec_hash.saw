/*
 * The SHA-256 spec layer's hash, SHA2.SHA256.Hash (Main's Hash), against
 * algorithms/SHA2/Main.cry's hash at SHA-256 (saw/SHA256Main.cry), with
 * the recursions it calls: Word_Of (in Parse_Block, in Parse) and
 * Foldl_Step. Included by sha256_spec.saw after sha256_spec_step.saw and
 * sha256_spec_pad.saw in the module's load with lax arithmetic, whose
 * verify_spec it uses (Hash calls Pad, whose lemmas are of that load).
 *
 * Hash (M) = Join (Foldl_Step (H0, Parse (Pad (M), N (l)), N (l)))
 * (0 .. 255): Pad, Parse, Join and the slice each leave their result on
 * the secondary stack, in that order. Pad and the two recursions are
 * overrides; Parse, Parse_Block, Join and Bit, which do not recurse, are
 * executed.
 */

/*
 * Word_Of (P, First, Count): the Count bits of P from First, read most
 * significant first: zext (take`{Count} (p << first)), the word that
 * Preprocessing.cry's split`{N * 16, w} cuts from P at First when Count
 * is 32. One lemma per Count in 0 .. 32, each with the lemma at Count - 1
 * as the override for its recursive call, for P of len bits (the padded
 * message, 512 times the number of blocks), First symbolic, First +
 * Count <= len. P and its bounds are writable and stated unchanged (Pad
 * leaves them on the secondary stack).
 *
 * Since #75 the recursion is the prelude's: Word_Of calls the SHA-256
 * Word_Sequences.Value (Cryptol.Join_Split), and Parse_Block calls
 * Word_Sequences.Split_At, which calls Value at Count = 32. So these
 * lemmas are Value's, with Word_Of's contract, and Parse_Block takes the
 * lemma at 32 through Split_At, which SAW executes.
 */
let word_of_contract (len : Int) (c : Int) = do {
  p <- llvm_fresh_var "p" (llvm_array len (llvm_int 8));
  llvm_precond {{ all (\b -> b <= 1) p }};
  pp <- llvm_alloc (llvm_array len (llvm_int 8));
  llvm_points_to pp (llvm_term p);
  pb <- llvm_alloc_aligned 1 bits_bounds_t;
  llvm_points_to pb (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `len - 1 : [128] }}]);
  first <- llvm_fresh_var "first" (llvm_int 128);
  llvm_precond {{ first <= `len - `c }};
  llvm_execute_func [llvm_struct_value [pp, pb], llvm_term first, llvm_term {{ `c : [32] }}];
  llvm_points_to pp (llvm_term p);
  llvm_points_to pb (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `len - 1 : [128] }}]);
  llvm_return (llvm_term {{ zext (take`{c} ((bits_of p) << first)) : [32] }});
};
rec word_of_lemmas (len : Int) (c : Int) (prev : [LLVMSpec]) : TopLevel LLVMSpec = do {
  lemma <- verify_spec "sha256__word_sequences__value" prev (word_of_contract len c) yices "yices"
             (str_concat (str_concat (str_concat (str_concat "P of " (show len)) " bits, Count = ") (show c))
                ": zext (take`{Count} (p << first)) (a word of Preprocessing.cry's parse)");
  if eval_bool {{ `c == (32 : Integer) }} then return lemma
  else word_of_lemmas len (eval_int {{ `c + 1 : [32] }}) [lemma];
};

/*
 * Parse (P, N) = Preprocessing.cry's parse`{w = 32, N} P (Preprocessing.cry:47,
 * [FIPS-PUB-180-4 Section 5.2]): parse M = split`{N, 16} (split`{N * 16, w} M),
 * on its own (#67 item 3), at the padded lengths Hash uses: N = 1 and 2
 * blocks, and 3 and 4 with saw_long. P is a fat pointer to 512 * N bits
 * with bounds {0, 512 * N - 1}, writable and stated unchanged, as
 * word_of_contract has it (in Hash it is Pad's result, on the secondary
 * stack). Parse allocates its N blocks on the empty secondary stack, a
 * bounds record {0, N - 1} then the 16 words of each block; its only
 * recursion is Word_Of's (Value's), through Parse_Block and Split_At,
 * which SAW executes: the override is Word_Of's lemma at Count = 32 for
 * P's length.
 */
let parse_contract (nb : Int) = do {
  let len = eval_int {{ 512 * `nb : [64] }};
  let sparse = ss_size 32 (eval_int {{ 64 * `nb : [64] }});
  stack <- secondary_stack;
  p <- llvm_fresh_var "p" (llvm_array len (llvm_int 8));
  llvm_precond {{ all (\b -> b <= 1) p }};
  pp <- llvm_alloc (llvm_array len (llvm_int 8));
  llvm_points_to pp (llvm_term p);
  pb <- llvm_alloc_aligned 1 bits_bounds_t;
  llvm_points_to pb (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `len - 1 : [128] }}]);
  llvm_execute_func [llvm_struct_value [pp, pb], llvm_term {{ `nb : [128] }}];
  ss_post stack sparse;
  llvm_points_to pp (llvm_term p);
  llvm_points_to pb (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `len - 1 : [128] }}]);
  llvm_points_to_untyped (ss_at stack 0) (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `nb - 1 : [128] }}]);
  llvm_points_to_untyped (ss_at stack 32) (llvm_term {{ parse`{32, nb} (bits_of p) }});
  llvm_return (llvm_struct_value [ss_at stack 32, ss_at stack 0]);
};
let verify_parse (nb : Int) (word_of : LLVMSpec) =
  verify_spec "sha256__parse" [word_of] (parse_contract nb) z3 "z3"
    (str_concat (str_concat (str_concat (str_concat "N = " (show nb)) ": Preprocessing::parse`{32, ") (show nb))
       "} (Preprocessing.cry's parse, at the padded lengths of Hash)");

/*
 * Foldl_Step (H, Ms, N) = foldl step h (take`{N} ms) for Ms of nt blocks
 * at N = nt, with Step's lemma as the override, and z3 with step
 * uninterpreted. H is read-only (Hash passes the constant H0); Ms and its
 * bounds are writable and stated unchanged (Parse leaves them on the
 * secondary stack).
 *
 * Since #75 the recursion is the prelude's: Foldl_Step (H, Ms, N) calls
 * the SHA-256 Blocks.Foldl_Take (H, Ms, N) (Cryptol.Folds), with the same
 * arguments, which recurses on N, one call per level. So this lemma is
 * Foldl_Take's, with Foldl_Step's contract, and Hash reaches it through
 * Foldl_Step, which SAW executes. Since #99 SAW unfolds the recursion: one
 * proof at N = nt, where there was a lemma per N in 0 .. nt.
 */
let block_vector_bounds_t = bits_bounds_t;
let foldl_step_contract (nt : Int) (n : Int) = do {
  h <- llvm_fresh_var "h" hash_value_t;
  hp <- llvm_alloc_readonly hash_value_t;
  llvm_points_to hp (llvm_term h);
  ms <- llvm_fresh_var "ms" (llvm_array nt block_t);
  msp <- llvm_alloc (llvm_array nt block_t);
  llvm_points_to msp (llvm_term ms);
  msb <- llvm_alloc_aligned 16 block_vector_bounds_t;
  llvm_points_to msb (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `nt - 1 : [128] }}]);
  llvm_execute_func [hp, llvm_struct_value [msp, msb], llvm_term {{ `n : [128] }}];
  llvm_points_to msp (llvm_term ms);
  llvm_points_to msb (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `nt - 1 : [128] }}]);
  llvm_return (llvm_term {{ foldl step h (take`{n} ms) }});
};
let verify_foldl_step (nt : Int) =
  verify_spec "sha256__blocks__foldl_take" [i_step] (foldl_step_contract nt nt)
    (w4_unint_z3 ["step"]) "w4_unint_z3 step"
    (str_concat (str_concat (str_concat (str_concat "Ms of " (show nt)) " blocks, N = ") (show nt))
       ", unfolded: foldl SHA256Main::step h (take`{N} ms) (Main.cry's hash's foldl)");

/*
 * Hash (M) = SHA256Main's hash`{l} M (Main.cry:55, [FIPS-PUB-180-4
 * Section 6.2]), at each length l: hash M = take (join (foldl step H0
 * (parse (pad M)))). M is a fat pointer to l bits; the 256-bit digest is
 * on the secondary stack, after Pad's, Parse's and Join's results. The
 * overrides are Pad's lemma at l, Word_Of's at Count = 32 for the padded
 * length, Foldl_Step's at N blocks, and z3 leaves step uninterpreted.
 */
let hash_used (l : Int) = do {
  let k = small_k l;
  let len = eval_int {{ `l + 1 + `k + 64 : [64] }};
  let nb = eval_int {{ `len / 512 : [64] }};
  let uz = ss_size 32 k;
  let t64 = to_bits_used 64;
  let sp = ss_size 32 len;
  let sparse = ss_size 32 (eval_int {{ 64 * `nb : [64] }});
  return (eval_int {{ `uz + `t64 + `sp + `sparse + 288 + 288 : [64] }});
};
/*
 * hash_contract_at base mode lo moff l: on the stack at `base` bytes,
 * with the message where `mode` says (sha256_spec_pad.saw's msg_frame);
 * hash_contract l is base 0, mode 0.
 */
let hash_contract_at (base : Int) (mode : Int) (lo : Int) (moff : Int) (l : Int) = do {
  let k = small_k l;
  let len = eval_int {{ `l + 1 + `k + 64 : [64] }};
  let nb = eval_int {{ `len / 512 : [64] }};
  let uz = ss_size 32 k;
  let t64 = to_bits_used 64;
  let sp = ss_size 32 len;
  let pad_after = eval_int {{ `base + `uz + `t64 + `sp : [64] }};
  let sparse = ss_size 32 (eval_int {{ 64 * `nb : [64] }});
  let at = eval_int {{ `pad_after + `sparse + 288 : [64] }};
  let data = eval_int {{ `at + 32 : [64] }};
  let after = eval_int {{ `at + 288 : [64] }};
  stack <- secondary_stack_used base;
  (msg, m, dp, bp, below) <- msg_frame stack mode lo moff l;
  llvm_execute_func [m];
  ss_post stack after;
  msg_frame_post stack mode lo moff l msg dp bp below;
  llvm_points_to_untyped (ss_at stack at) (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ 255 : [128] }}]);
  llvm_points_to_untyped (ss_at stack data) (llvm_term {{ bytes_of (hash`{l} (bits_of msg)) }});
  llvm_return (llvm_struct_value [ss_at stack data, ss_at stack at]);
};
let hash_contract (l : Int) = hash_contract_at 0 0 0 0 l;

/*
 * NEGATIVE CONTROL: must FAIL. check-saw.sh fails if it proves.
 *
 * The spec layer's Join_Block (obj/spec/aes_spec.bc; since #75 the
 * prelude's Byte_Bits.Join of the block, on the secondary stack, copied
 * out) against Main.cry's join of the block's bytes reversed, with the
 * secondary stack, overrides (none) and tactic of aes_spec_main.saw's
 * proof. The proof must fail with a counterexample block, which shows
 * that the function as compiled is the one checked and that it is told
 * from the wrong Cryptol.
 */

include "../aes_spec_common.saw";

let join_block_hwm = ss_size 4 128;
verify_spec "main__join_block" []
  (do {
     hwm <- llvm_fresh_var "hwm" (llvm_int 64);
     llvm_precond {{ hwm <= `ss_chunk_size }};
     stack <- secondary_stack_hwm 0 hwm;
     b <- llvm_fresh_var "b" block_t;
     ret <- llvm_alloc (llvm_array 128 byte_t);
     llvm_execute_func [ret, llvm_term b];
     ss_post_hwm_t stack 0 {{ if hwm < `join_block_hwm then `join_block_hwm else hwm }};
     llvm_points_to ret (llvm_term {{ [ if x then 1 else 0 | x <- join (reverse b) ] : [128][8] }});
   }) z3 "z3" "join (reverse b)";

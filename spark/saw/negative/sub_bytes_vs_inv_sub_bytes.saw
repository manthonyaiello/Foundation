/*
 * NEGATIVE CONTROL: must FAIL. check-saw.sh fails if it proves.
 *
 * Sub_Bytes against Cipher.cry's InvSubBytes instead of SubBytes, with
 * the same SBox_Lanes override as aes_impl.saw (since #50 Sub_Bytes calls
 * the bitsliced SBox_Lanes, not Sub_Byte). The proof must fail with a
 * counterexample state, which shows the override does not make the
 * Sub_Bytes proof vacuous. (Run on the IOD, 2026-10-21: it fails.)
 */

include "../aes_impl_common.saw";

sbox_lanes <- verify_impl "sbox_lanes" []
                (lanes_contract {{ \(x : [64]) -> join [ SBox @ b | b <- (split x : [8][8]) ] }})
                "\\x -> join [SBox::SBox @ b | b <- split x]";
verify_impl "sub_bytes" [sbox_lanes] (block_in_out_contract {{ InvSubBytes }})
            "Cipher::InvSubBytes";

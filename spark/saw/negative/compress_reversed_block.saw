/*
 * NEGATIVE CONTROL: must FAIL. check-saw.sh fails if it proves.
 *
 * Compress against SHA256Main's step of the block's words in reverse
 * order, with every override and the tactic of sha256_impl.saw's proof
 * (z3 with the SIGMA and sigma functions uninterpreted). It runs
 * sha256_impl.saw first, for the overrides. The proof must fail with a
 * counterexample, which shows that the overrides and the uninterpreted
 * functions do not make the Compress proof vacuous: which message word
 * each round reads is checked.
 */

include "../sha256_impl.saw";

verify_symbol (stream_symbol "compress") "sha256_stream.compress (against the reversed block)"
  [sigma_0, sigma_1, small_sigma_0, small_sigma_1, ch, maj, hash_value_add]
  (compress_contract {{ \h m -> step h (reverse m) }})
  (w4_unint_z3 compress_unint) "w4_unint_z3 SIGMA_256_0 SIGMA_256_1 sigma_256_0 sigma_256_1"
  "\\h m -> SHA256Main::step h (reverse m)";

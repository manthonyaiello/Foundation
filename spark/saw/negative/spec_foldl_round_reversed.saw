/*
 * NEGATIVE CONTROL: must FAIL. check-saw.sh fails if it proves.
 *
 * One of aes_spec.saw's fold lemmas with the wrong Cryptol:
 * the fold of Foldl_Round is the prelude's Round_Folds.Foldl_Take, and
 * this is its lemma at M = 9 (the length Cipher at k = 128 folds), N = 9,
 * against foldl Round z (take`{9} (reverse xs)), with the overrides of
 * the true lemma there (Round's and the lemma at N = 8) and its tactic
 * (z3 with Round uninterpreted). It runs aes_spec_gf.saw and
 * aes_spec_cipher.saw first, for the lemmas. The proof must fail with a
 * counterexample, which shows that the fold lemmas' overrides and Round
 * uninterpreted do not make them vacuous: the order of the round keys is
 * checked.
 */

include "../aes_spec_common.saw";
include "../aes_spec_gf.saw";
include "../aes_spec_cipher.saw";

n8 <- foldl_takes true "cipher__round_folds__foldl_take" c_round {{ Round }} "Round" 9 8 0 [];
verify_spec "cipher__round_folds__foldl_take" [n8, c_round]
  (foldl_take_contract_rhs true 9 9 {{ \z (xs : [9][16][8]) -> foldl Round z (take`{9} (reverse xs)) }})
  (w4_unint_z3 ["Round"]) "w4_unint_z3 Round" "M = 9, N = 9: foldl Cipher::Round z (reverse xs)";

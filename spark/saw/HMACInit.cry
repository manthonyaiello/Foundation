/*
 * algorithms/HMAC/Main.cry's HMAC_init (Main.cry:56 to :65), copied text
 * for text, for spark/saw/sha256_spec_hmac.saw: Main.cry declares it
 * `private`, so it cannot be named from outside Main, and the spec
 * layer's HMAC.SHA256.HMAC_init is proved against this copy. The copy is
 * tied to Main.cry by the proof of the spec layer's HMAC against Main.cry's
 * own `HMAC`, which takes HMAC_init's lemmas as its overrides (as
 * SHA256Step.cry's copies of `step`'s locals are tied to `step`). NSA's
 * Cryptol is not modified.
 */
module HMACInit where

/**
 * This function initializes the HMAC key `K` by performing step 1-3
 * of [FIPS-PUB-198-1 Section 4 Table 1]. Step 2 implicitly requires
 * `L <= B`.
 */
HMAC_init :
    { B, k, L }
    ( fin B, fin k, L <= B )
 => ([k * 8] -> [L * 8])
 -> [k][8]
 -> [B * 8]
HMAC_init Hk K
  | k == B => join K
  | k >  B => Hk (join K) # (zero : [(B - L) * 8])
  | k <  B => join K      # (zero : [(B - k) * 8])

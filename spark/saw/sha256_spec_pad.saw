/*
 * The SHA-256 spec layer's padding, SHA2.SHA256.Pad (Main's Pad, mirroring
 * algorithms/SHA2/Preprocessing.cry's pad, which has no executable
 * counterpart: the implementation's Final writes only the last one or two
 * padded blocks), with what it calls: Small_K, Zero and the SHA2 root's
 * To_Bits. Included by sha256_spec.saw after the module's load with lax
 * arithmetic (below), whose verify_spec it uses.
 *
 * At the message lengths of M4.3's Hash proofs (README "SAW"): 0, 1, 55,
 * 56, 63, 64, 65, 100, 119, 120, 128 and 200 bytes, l = 8 times that in
 * bits.
 *
 * Bits (SHA2.Bits, index Bit_Index, 0 .. 2 ** 126) is a ghost Boolean
 * array: one byte per bit, 0 or 1 (an Ada Boolean's validity is the
 * precondition), as a fat pointer whose bounds record is two i128,
 * {First, Last} (README "The bitcode ABI"). Each of Pad, Zero and To_Bits
 * returns its Bits on the secondary stack (secondary_stack.saw): the
 * contracts state where, and the stack's state after the call.
 *
 * Lax arithmetic. To_Bits (V, 1) concatenates To_Bits (V / 2, 0), the
 * null range {0, -1}, and GNAT-LLVM computes a range's length as
 * select (Lo > Hi, 0, (Hi - Lo) +nuw 1): the add wraps to a poison value
 * that the select discards, which crucible refuses at its creation (the
 * case M4.3 met in Final; README "The bitcode ABI"). Pad on an empty
 * message does the same. So To_Bits' lemmas, which rest on the one at
 * width 1, and Pad's, which rest on them, are proved in a load of the
 * module with lax arithmetic, under which overflow is not an obligation:
 * absence of overflow in these functions is gnatprove's (it proves it).
 */

let bits_bounds_t = llvm_alias "foundation_spark__sha2__bits_BOUNDS";

/* Bytes, each 0 or 1, as Cryptol bits, and bits as such bytes. */
let bits_of = {{ \bs -> [ b == (1 : [8]) | b <- bs ] }};
let bytes_of = {{ \x -> [ if b then (1 : [8]) else 0 | b <- x ] }};

/*
 * The message lengths, in bits, grouped by their k = Small_K (l) (447,
 * 439, 7, 511, 455, 159, 383): Zero's lemma and To_Bits' chain (below)
 * depend on k alone, and are proved once per group.
 */
let pad_length_groups = [[0, 512, 1024], [8, 520], [440, 952], [448, 960], [504], [800], [1600]];

/*
 * Small_K (L) = hash's type k = (l + 1 + 2 * w) %^ m (Main.cry:58) at
 * w = 32, m = 512: a value at each length (both sides are constants).
 */
let small_k (l : Int) = eval_int {{ `((l + 65) %^ 512) : [64] }};
let verify_small_k (l : Int) =
  verify_spec "sha256__small_k" []
    (do {
       llvm_execute_func [llvm_term {{ `l : [128] }}];
       llvm_return (llvm_term {{ `((l + 65) %^ 512) : [128] }});
     }) z3 "z3" (str_concat (str_concat "L = " (show l)) ": `((L + 1 + 2 * 32) %^ 512) (Main.cry's hash's k)");

/*
 * The secondary stack's base. Hash and the lemmas under it are proved
 * on an empty secondary stack (base 0) for sha256_spec_hash.saw's Hash
 * proofs, and again with `base` bytes already allocated for the calls
 * HMAC makes (sha256_spec_hmac.saw): an override applies only where the
 * stack's Top is the one its contract states. The bytes below the base
 * are not described (the callee neither reads nor writes them) except
 * those kept (keep_at): what the caller reads after the call.
 */
let at_base (base : Int) (name : String) =
  if eval_bool {{ `base == (0 : Integer) }} then name
  else str_concat (str_concat (str_concat name ", the secondary stack at ") (show base)) " bytes";

/*
 * n bytes of the stack's memory from offset off, as found and left (as
 * secondary_stack.saw's keep_pre and keep_post, at an offset): bound in
 * the precondition, stated unchanged in the postcondition.
 */
let keep_at stack (off : Int) (n : Int) = do {
  if eval_bool {{ `n == (0 : Integer) }} then return {{ [] : [0][8] }}
  else do {
    kept <- llvm_fresh_var "kept" (llvm_array n (llvm_int 8));
    llvm_points_to_untyped (ss_at stack off) (llvm_term kept);
    return kept;
  };
};
let keep_at_post stack (off : Int) (n : Int) (kept : Term) =
  if eval_bool {{ `n == (0 : Integer) }} then return ()
  else llvm_points_to_untyped (ss_at stack off) (llvm_term kept);

/*
 * Where Pad's and Hash's message M (l bits) is, by mode:
 *  0: a read-only allocation of its own, with read-only bounds (a caller's
 *     argument: sha256_spec_hash.saw's Hash proofs);
 *  1: a writable allocation of its own, with writable bounds, stated
 *     unchanged (a temporary of the caller's: HMAC's Hn and HL get the
 *     concatenations HMAC builds on the primary stack);
 *  2: on the secondary stack at offset moff, bounds then bits (32 bytes
 *     later), below the base, stated unchanged (a result the caller got
 *     from SS_Allocate: HMAC_init's Hk gets Join (K)); with it, the bytes
 *     from lo up to moff, which the caller reads after the call (the
 *     second HMAC_init's caller's), also stated unchanged (lo = moff:
 *     none).
 * msg_frame binds M and returns it with the fat pointer to pass, the
 * data and bounds pointers, and the bytes kept below M; msg_frame_post
 * states them unchanged. When SAW applies an override, the bytes of the
 * stack its postcondition does not state are lost to the caller.
 */
let msg_frame stack (mode : Int) (lo : Int) (moff : Int) (l : Int) = do {
  below <- if eval_bool {{ `mode == (2 : Integer) }} then keep_at stack lo (eval_int {{ `moff - `lo : [64] }})
           else return {{ [] : [0][8] }};
  msg <- llvm_fresh_var "msg" (llvm_array l (llvm_int 8));
  llvm_precond {{ all (\b -> b <= 1) msg }};
  let bounds = llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `l - 1 : [128] }}];
  if eval_bool {{ `mode == (2 : Integer) }} then do {
    llvm_points_to_untyped (ss_at stack moff) bounds;
    llvm_points_to_untyped (ss_at stack (eval_int {{ `moff + 32 : [64] }})) (llvm_term msg);
    let dp = ss_at stack (eval_int {{ `moff + 32 : [64] }});
    let bp = ss_at stack moff;
    return (msg, llvm_struct_value [dp, bp], dp, bp, below);
  } else do {
    mp <- if eval_bool {{ `mode == (0 : Integer) }} then llvm_alloc_readonly (llvm_array l (llvm_int 8))
          else llvm_alloc (llvm_array l (llvm_int 8));
    llvm_points_to mp (llvm_term msg);
    mb <- if eval_bool {{ `mode == (0 : Integer) }} then llvm_alloc_readonly bits_bounds_t
          else llvm_alloc_aligned 1 bits_bounds_t;
    llvm_points_to mb bounds;
    return (msg, llvm_struct_value [mp, mb], mp, mb, below);
  };
};
let msg_frame_post stack (mode : Int) (lo : Int) (moff : Int) (l : Int) (msg : Term) dp bp (below : Term) = do {
  let bounds = llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `l - 1 : [128] }}];
  if eval_bool {{ `mode == (0 : Integer) }} then return ()
  else if eval_bool {{ `mode == (1 : Integer) }} then do {
    llvm_points_to dp (llvm_term msg);
    llvm_points_to bp bounds;
  } else do {
    keep_at_post stack lo (eval_int {{ `moff - `lo : [64] }}) below;
    llvm_points_to_untyped dp (llvm_term msg);
    llvm_points_to_untyped bp bounds;
  };
};
/* The region to keep on the secondary stack (mode 2: from lo to the message's end), its size. */
let msg_keep_size (mode : Int) (lo : Int) (moff : Int) (l : Int) =
  if eval_bool {{ `mode == (2 : Integer) }} then eval_int {{ `moff - `lo + 32 + `l : [64] }} else 0;

/*
 * Zero (Count) = Cryptol's zero : [k], at k = Small_K (l) for each
 * length: Count bytes of 0 with bounds {0, Count - 1}, on the secondary
 * stack at `base` bytes, keeping the kn bytes at ko (Pad's message, when
 * it is on the stack).
 */
let verify_zero_at (base : Int) (ko : Int) (kn : Int) (k : Int) =
  verify_spec "sha256__zero" []
    (do {
       let sz = ss_size 32 k;
       stack <- secondary_stack_used base;
       kept <- keep_at stack ko kn;
       llvm_execute_func [llvm_term {{ `k : [128] }}];
       ss_post stack (eval_int {{ `base + `sz : [64] }});
       keep_at_post stack ko kn kept;
       llvm_points_to_untyped (ss_at stack base) (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `k - 1 : [128] }}]);
       llvm_points_to_untyped (ss_at stack (eval_int {{ `base + 32 : [64] }})) (llvm_term {{ bytes_of (zero : [k]) }});
       llvm_return (llvm_struct_value [ss_at stack (eval_int {{ `base + 32 : [64] }}), ss_at stack base]);
     }) z3 "z3" (at_base base (str_concat (str_concat "zero : [" (show k)) "] (Preprocessing.cry's pad's zero)"));
let verify_zero (k : Int) = verify_zero_at 0 0 0 k;

/*
 * To_Bits (V, W): the W-bit big-endian representation of V, Cryptol's
 * (`l : [2 * w]) in pad at W = 64: drop`{128 - W} (v : [128]). One lemma
 * per width W in 0 .. 64, each with the lemma at W - 1 as the override for
 * its recursive call, all with the secondary stack at `used` bytes when
 * the chain starts (Pad calls To_Bits after Zero), of which the first
 * `keep` (Zero's result) are left as found: To_Bits (V, W) calls
 * To_Bits (V / 2, W - 1) first, which leaves its own result and every
 * shorter one on the stack (to_bits_used), and then allocates its
 * result.
 *
 * Since #75 the recursion is the prelude's: To_Bits calls SHA2's
 * Sequences_Of_Bits.Literal (Cryptol.Bit_Sequences) with the same
 * arguments, so these lemmas are Literal's, and Pad reaches the one at 64
 * through To_Bits, which SAW executes; likewise Zero now calls
 * Sequences_Of_Bits.Zero. Unverified until the next SAW session (PLAN
 * step 7), and the secondary-stack accounting is the part to check
 * first: if GNAT copies a wrapper's unconstrained result on the
 * secondary stack, rather than passing the callee's through, the byte
 * counts here and in Pad's contract move.
 */
let to_bits_used (w : Int) = eval_int {{ sum [ ((32 + j + 15) / 16) * 16 | j <- [0 .. w] ] : [64] }};
/*
 * The two regions kept are (o1, n1) and (o2, n2): Zero's result, and
 * Pad's message when it is on the stack (else n2 = 0). Pad on an empty
 * stack keeps the first 32 + k bytes, (0, 32 + k): to_bits_lemmas.
 */
let to_bits_contract_at (used : Int) (o1 : Int) (n1 : Int) (o2 : Int) (n2 : Int) (w : Int) = do {
  let is0 = eval_bool {{ `w == (0 : Integer) }};
  let before = if is0 then 0 else to_bits_used (eval_int {{ `w - 1 : [64] }});
  let at = eval_int {{ `used + `before : [64] }};
  let data = eval_int {{ `at + 32 : [64] }};
  let tw = to_bits_used w;
  let after = eval_int {{ `used + `tw : [64] }};
  stack <- secondary_stack_used used;
  kept1 <- keep_at stack o1 n1;
  kept2 <- keep_at stack o2 n2;
  v <- llvm_fresh_var "v" (llvm_int 128);
  llvm_precond {{ v <= 2 ^^ 126 }};
  llvm_execute_func [llvm_term v, llvm_term {{ `w : [128] }}];
  ss_post stack after;
  keep_at_post stack o1 n1 kept1;
  keep_at_post stack o2 n2 kept2;
  llvm_points_to_untyped (ss_at stack at) (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `w - 1 : [128] }}]);
  if is0 then return ()
  else llvm_points_to_untyped (ss_at stack data) (llvm_term {{ bytes_of (drop`{128 - w} v) }});
  llvm_return (llvm_struct_value [ss_at stack data, ss_at stack at]);
};
rec to_bits_lemmas_at (used : Int) (o1 : Int) (n1 : Int) (o2 : Int) (n2 : Int) (w : Int) (prev : [LLVMSpec]) : TopLevel LLVMSpec = do {
  lemma <- verify_spec "sequences_of_bits__literal" prev (to_bits_contract_at used o1 n1 o2 n2 w) z3 "z3"
             (str_concat (str_concat (str_concat (str_concat "W = " (show w)) ", the secondary stack at ") (show used))
                " bytes: drop`{128 - W} (v : [128]) ((`l : [2 * w]) in Preprocessing.cry's pad)");
  if eval_bool {{ `w == (64 : Integer) }} then return lemma
  else to_bits_lemmas_at used o1 n1 o2 n2 (eval_int {{ `w + 1 : [32] }}) [lemma];
};
let to_bits_lemmas (used : Int) (keep : Int) (w : Int) (prev : [LLVMSpec]) =
  to_bits_lemmas_at used 0 keep 0 0 w prev;

/*
 * Pad (M) = Preprocessing.cry's pad`{m = 512, w = 32, l, k} M
 * [FIPS-PUB-180-4 Section 5.1.1]: pad M = M # 0b1 # zero # (`l : [64]),
 * at each length l, with k = Small_K (l). M is a fat pointer to l bits
 * with bounds {0, l - 1}. Pad calls Small_K, then Zero (on the empty
 * stack), then To_Bits (l, 64) (the stack at Zero's result), and then
 * allocates its result: their lemmas are the overrides, To_Bits' chain
 * proved for this stack.
 */
let pad_contract_at (base : Int) (mode : Int) (lo : Int) (moff : Int) (l : Int) = do {
  let k = small_k l;
  let len = eval_int {{ `l + 1 + `k + 64 : [64] }};
  let uz = ss_size 32 k;
  let t64 = to_bits_used 64;
  let at = eval_int {{ `base + `uz + `t64 : [64] }};
  let data = eval_int {{ `at + 32 : [64] }};
  let sz = ss_size 32 len;
  let after = eval_int {{ `at + `sz : [64] }};
  stack <- secondary_stack_used base;
  (msg, m, dp, bp, below) <- msg_frame stack mode lo moff l;
  llvm_execute_func [m];
  ss_post stack after;
  msg_frame_post stack mode lo moff l msg dp bp below;
  llvm_points_to_untyped (ss_at stack at) (llvm_struct_value [llvm_term {{ 0 : [128] }}, llvm_term {{ `len - 1 : [128] }}]);
  llvm_points_to_untyped (ss_at stack data) (llvm_term {{ bytes_of (pad`{512, 32, l, k} (bits_of msg)) }});
  llvm_return (llvm_struct_value [ss_at stack data, ss_at stack at]);
};
let pad_contract (l : Int) = pad_contract_at 0 0 0 0 l;

/*
 * Pad's lemma at length l, on the stack at `base` bytes with its message
 * where `mode` says (msg_frame), and the lemmas it rests on, proved for
 * that stack: Small_K's, Zero's (keeping the message if it is on the
 * stack) and To_Bits' chain (keeping Zero's result, and the message).
 */
let verify_pad_at (base : Int) (mode : Int) (lo : Int) (moff : Int) (l : Int) = do {
  let k = small_k l;
  let uz = ss_size 32 k;
  let mk = msg_keep_size mode lo moff l;
  sk <- verify_small_k l;
  z <- verify_zero_at base lo mk k;
  tb <- to_bits_lemmas_at (eval_int {{ `base + `uz : [64] }}) base (eval_int {{ 32 + `k : [64] }}) lo mk 0 [];
  verify_spec "sha256__pad" [sk, z, tb] (pad_contract_at base mode lo moff l) z3 "z3"
    (at_base base (str_concat (str_concat "l = " (show l)) ": Preprocessing::pad`{512, 32, l, (l + 65) %^ 512}"));
};

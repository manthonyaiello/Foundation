/*
 * What the SHA-256 and HMAC-SHA-256 implementation's SAW scripts share:
 * the bitcode, NSA's Cryptol, and the contracts, one per shape of Ada
 * subprogram, as aes_impl_common.saw has them for AES.
 *
 * Run from spark/saw/ by spark/scripts/check-saw.sh, which first compiles
 * spark/src/sha2/foundation_spark-sha2-sha256_stream.adb, foundation_
 * spark-sha2-sha256.ads (the SHA-256 instance of the generic Main),
 * foundation_spark-sha2-functions.ads and spark/src/hmac/foundation_
 * spark-hmac-sha256_impl.adb with GNAT Pro's LLVM back end and links them
 * into obj/sha256.bc. Not run by CI: see spark/README.md, "SAW".
 */

enable_experimental;

/*
 * NSA's Cryptol, imported unmodified. CRYPTOLPATH is the repository's
 * root (check-saw.sh sets it).
 *
 * SHA256Main.cry (in this directory) is algorithms/SHA2/Main.cry at
 * SHA256.cry's parameters, the same instance SHA256.cry makes privately;
 * it exports that instance's `step` (Main.cry:67) and `hash`
 * (Main.cry:55). SHA256.cry itself cannot be loaded by SAW 1.6:
 * SHA256.cry is `packaging::Hash` instantiated, packaging/Hash.cry
 * imports algorithms/PBKDF/Main.cry, and SAW's translation of that
 * module to SAWCore fails ("Argument type not subtype of expected type",
 * at a `parmap` over `kLen /^ hLen` blocks), with `import` and with
 * `cryptol_load` alike. For the same reason packaging/Hash.cry's `HMAC`
 * is stated here as Hash.cry states it (Hash.cry:71):
 * algorithms/HMAC/Main.cry's HMAC`{B = BlockSize / 8, L = DigestSize / 8}
 * with Hk = Hn = HL = hash, that is HMAC`{256, 64, k, n, 32} hash hash
 * hash (λ = DigestSize = 256: Hash.cry's HMAC returns [DigestSize]).
 */
import "SHA256Main.cry";
import "../../algorithms/SHA2/Notation.cry";
import "../../algorithms/SHA2/Functions.cry";
import "../../algorithms/HMAC/Main.cry";

/*
 * The four units as bitcode, compiled with -O0 and without -g
 * (spark/README.md, "SAW", says why both), linked by llvm-link: SAW takes
 * an override only from the module it verifies, and SHA256_Stream calls
 * the SHA-256 instance and Functions, HMAC.SHA256_Impl SHA256_Stream.
 */
sha256_impl <- llvm_load_module "obj/sha256.bc";

/*
 * The Ada names as LLVM symbols: GNAT's external names, the expanded name
 * in lower case with "__" for each ".".
 */
let functions_symbol name = str_concat "foundation_spark__sha2__functions__" name;
let instance_symbol name = str_concat "foundation_spark__sha2__sha256__" name;
let stream_symbol name = str_concat "foundation_spark__sha2__sha256_stream__" name;
let hmac_symbol name = str_concat "foundation_spark__hmac__sha256_impl__" name;

/*
 * The LLVM types of the Ada ones: Unsigned_32 is i32, Byte i8,
 * Hash_Value (Words_32 (0 .. 7)) [8 x i32], Block (Words_32 (0 .. 15))
 * [16 x i32].
 */
let word_t = llvm_int 32;
let byte_t = llvm_int 8;
let hash_value_t = llvm_array 8 word_t;
let block_t = llvm_array 16 word_t;

/*
 * function F (X : Unsigned_32) return Unsigned_32: Notation's SHR and
 * ROTR in each instance, and Functions' SIGMA and sigma functions.
 */
let word_to_word_contract (f : Term) = do {
  x <- llvm_fresh_var "x" word_t;
  llvm_execute_func [llvm_term x];
  llvm_return (llvm_term {{ f x }});
};

/*
 * function F (X, Y, Z : Word) return Word: Ch and Maj, of the instance
 * Logical of Functions.Logical at Unsigned_32. Functions.cry's Ch and Maj
 * take a tuple (x, y, z).
 */
let three_words_contract (f : Term) = do {
  x <- llvm_fresh_var "x" word_t;
  y <- llvm_fresh_var "y" word_t;
  z <- llvm_fresh_var "z" word_t;
  llvm_execute_func [llvm_term x, llvm_term y, llvm_term z];
  llvm_return (llvm_term {{ f (x, y, z) }});
};

/*
 * function "+" (Left, Right : Hash_Value) return Hash_Value: GNAT-LLVM
 * passes the two [8 x i32] by reference (read-only pointers) and returns
 * the sum by value.
 */
let hash_value_add_contract = do {
  a <- llvm_fresh_var "a" hash_value_t;
  ap <- llvm_alloc_readonly hash_value_t;
  llvm_points_to ap (llvm_term a);
  b <- llvm_fresh_var "b" hash_value_t;
  bp <- llvm_alloc_readonly hash_value_t;
  llvm_points_to bp (llvm_term b);
  llvm_execute_func [ap, bp];
  llvm_return (llvm_term {{ a + b }});
};

/*
 * procedure Compress (H : in out Hash_Value; M : Block): unlike AES's
 * Block (16 bytes, passed by value), GNAT-LLVM passes both by reference:
 * H as a writable pointer to [8 x i32], M as a read-only pointer to
 * [16 x i32]. The result is stated with llvm_points_to on H. f is
 * SHA256Main's step : [8][32] -> [16][32] -> [8][32].
 */
let compress_contract (f : Term) = do {
  h <- llvm_fresh_var "h" hash_value_t;
  hp <- llvm_alloc hash_value_t;
  llvm_points_to hp (llvm_term h);
  m <- llvm_fresh_var "m" block_t;
  mp <- llvm_alloc_readonly block_t;
  llvm_points_to mp (llvm_term m);
  llvm_execute_func [hp, mp];
  llvm_points_to hp (llvm_term {{ f h m }});
};

/*
 * A Byte_Array argument of n bytes (SHA256_Bytes.Byte_Array, indexed by
 * the 64-bit Byte_Index): a fat pointer { data, bounds }, the n bytes
 * read-only, and the bounds record { i64, i64 } = {0, n - 1} (for n = 0,
 * {0, -1}: a null range). Returns the bytes' Cryptol variable, [n][8],
 * and the fat pointer.
 */
let byte_array_arg (n : Int) (name : String) = do {
  xs <- llvm_fresh_var name (llvm_array n byte_t);
  p <- llvm_alloc_readonly (llvm_array n byte_t);
  llvm_points_to p (llvm_term xs);
  b <- llvm_alloc_readonly (llvm_alias "foundation_spark__sha2__sha256_bytes__byte_array_BOUNDS");
  llvm_points_to b (llvm_struct_value [llvm_term {{ 0 : [64] }}, llvm_term {{ (`n : [64]) - 1 }}]);
  return (xs, llvm_struct_value [p, b]);
};

/*
 * function Hash (M : Byte_Array) return Digest, at one length of n bytes:
 * the digest, Byte_Array (0 .. 31), is returned by value as [32 x i8].
 * f : [n][8] -> [32][8] is the Cryptol at that length.
 */
let hash_contract (n : Int) (f : Term) = do {
  (msg, ma) <- byte_array_arg n "msg";
  llvm_execute_func [ma];
  llvm_return (llvm_term {{ f msg }});
};

/*
 * function HMAC_SHA256 (Key : Byte_Array; Text : Byte_Array) return
 * Digest, at k key bytes and n text bytes. f : [k][8] -> [n][8] ->
 * [32][8] is the Cryptol at those lengths.
 */
let hmac_contract (k : Int) (n : Int) (f : Term) = do {
  (key, ka) <- byte_array_arg k "key";
  (text, ta) <- byte_array_arg n "text";
  llvm_execute_func [ka, ta];
  llvm_return (llvm_term {{ f key text }});
};

/*
 * The same bitcode loaded a second time with SAW's lax arithmetic, for
 * the proofs that need it (sha256_impl.saw, "Null slices"): SAW applies
 * the setting when it translates the module, at llvm_load_module, so it
 * cannot be switched on for one llvm_verify of a module loaded without
 * it. It is switched off again at once: sha256_impl above, and every
 * proof of it, keeps the strict rules. An override must come from the
 * module verified, so the proofs of this module re-prove their overrides
 * in it.
 */
enable_lax_arithmetic;
sha256_impl_lax <- llvm_load_module "obj/sha256.bc";
disable_lax_arithmetic;

/*
 * llvm_verify of one subprogram (its LLVM symbol) of module m against a
 * Cryptol term, with the overrides given and the proof tactic named,
 * timed, and a line check-saw.sh records: "RESULT proved <name> =
 * <cryptol> [<tactic>]". verify_symbol is it on the strict module.
 */
let verify_symbol_in m symbol name overrides contract tactic tactic_name cryptol = do {
  result <- time (llvm_verify m symbol overrides false contract tactic);
  print (str_concat (str_concat (str_concat (str_concat (str_concat "RESULT proved " name) " = ") cryptol) " [") (str_concat tactic_name "]"));
  return result;
};
let verify_symbol = verify_symbol_in sha256_impl;

/*
 * The Cryptol functions left uninterpreted above Compress: `step`, whose
 * proof is Compress's override, and the four SIGMA and sigma functions,
 * whose proofs are Compress's overrides. Ch and Maj are interpreted:
 * Functions.cry's take a tuple, and SAW 1.6's what4 back end cannot make
 * an uninterpreted function of a tuple argument ("Cannot create
 * uninterpreted higher-order function Ch_..."); they are three bitwise
 * operations, cheap to the solver.
 */
let compress_unint = ["SIGMA_256_0", "SIGMA_256_1", "sigma_256_0", "sigma_256_1"];
let hash_unint = concat ["step"] compress_unint;

/*
 * What the AES spec layer's SAW script shares: the bitcode of the ghost
 * spec units, NSA's Cryptol, and the contracts, one per shape of Ada
 * subprogram.
 *
 * Run from spark/saw/ by spark/scripts/check-saw.sh, which first compiles
 * the spec units (AES.Spec.Types, .GF28, .GF2, .SBox, .Cipher,
 * .KeyExpansion, .Main, and the instances .AES128, .AES192 and .AES256
 * of the generic AES_K) with GNAT Pro's LLVM back end, ghost code enabled
 * (saw/spec.adc) and inlining off, into obj/spec/, and links them into
 * obj/spec/aes_spec.bc. Not run by CI: see spark/README.md, "SAW".
 *
 * The {k} functions (KeyExpansion and its W, Cipher, InvCipher,
 * InvCipher', Split_Key, Encrypt, Decrypt) are the generic AES_K's:
 * one symbol per instance, aes128__cipher and so on (instance_symbol),
 * with no K argument, and their arrays of the instance's constrained
 * subtypes (Key_Words (0 .. Nk - 1), Round_Keys (0 .. Nr), Key_Bits
 * (0 .. K - 1)) passed without bounds. These contracts were written on a
 * machine without GNAT-LLVM; a session on the x86_64 instance on
 * 2026-10-21 read the ABI from GNAT-LLVM 27's IR and ran them. A constrained array argument of
 * at most 16 bytes goes by value, a larger one by reference: the key
 * words by value at k = 128 (16 bytes), by reference at 192 and 256 (24
 * and 32 bytes). KeyExpansion's Round_Keys (176 to 240 bytes) and
 * Encrypt's Block_Bits come back through a pointer the caller passes
 * first (sret); Split_Key's Key_Words come back by value at every k
 * (aes_spec_main.saw).
 */

enable_experimental;

/*
 * NSA's Cryptol, imported unmodified. CRYPTOLPATH is the repository's
 * root (check-saw.sh sets it). GF2.cry is imported for the names SBox.cry
 * uses and does not re-export. Its operators (^*) = pmult, (^/) = pdiv
 * and (^%) = pmod are Cryptol's primitives renamed, and SAWScript's
 * import list takes no operator, so the contracts name the primitives.
 */
import "../../algorithms/AES/GF28.cry";
import "../../algorithms/AES/SBox.cry";
import "../../algorithms/AES/Cipher.cry";
import "../../algorithms/AES/KeyExpansion.cry";
import "../../shared/algebra/Polynomial/GF2.cry" (pdeg, pgcd, inverse);
import "../../algorithms/AES/Main.cry" (AES, AES128, AES192, AES256);

/*
 * The spec units as bitcode, compiled with -O0, without -g and with
 * -fno-inline (spark/README.md, "SAW", says why), linked by llvm-link.
 */
aes_spec <- llvm_load_module "obj/spec/aes_spec.bc";

/*
 * The Ada names as LLVM symbols: GNAT's external names, unchanged for
 * ghost entities too (GNAT-LLVM 27 adds no ___ghost_ prefix; README "The
 * bitcode ABI").
 */
let spec_symbol name = str_concat "foundation_spark__aes__spec__" name;

/*
 * The name, under spec_symbol, of a function of the instance of AES_K at
 * key size k: Spec.AES128's Cipher is "aes128__cipher".
 */
let instance_symbol (k : Int) (name : String) =
  str_concat (str_concat (str_concat "aes" (show k)) "__") name;

/*
 * The LLVM types of the Ada ones: Byte is i8, a Boolean i8 (0 or 1),
 * Natural and Integer i32, GF28.Poly and GF2.Poly i16, GF2.Product i32,
 * AESWord [4 x i8], Block [16 x i8], Columns [4 x [4 x i8]],
 * GF2.Poly_State [6 x i16], GF2.Pgcd_Result [5 x i16].
 */
let byte_t = llvm_int 8;
let poly_t = llvm_int 16;
let word_t = llvm_array 4 byte_t;
let block_t = llvm_array 16 byte_t;

/*
 * Whether the instance at nk key words passes and returns its
 * Key_Words by value (16 bytes, at k = 128) rather than by reference
 * (see the header).
 */
let key_words_by_value (nk : Int) = eval_bool {{ `nk == (4 : Integer) }};

/*
 * A Key_Words argument of nk words: by value, or a writable pointer to
 * them (the caller's is a stack temporary). Returns the words and the
 * argument; key_words_kept states a pointed-to one unchanged after the
 * call.
 */
let key_words_arg (nk : Int) = do {
  key <- llvm_fresh_var "key" (llvm_array nk word_t);
  if key_words_by_value nk then return (key, llvm_term key)
  else do {
    keyp <- llvm_alloc (llvm_array nk word_t);
    llvm_points_to keyp (llvm_term key);
    return (key, keyp);
  };
};
let key_words_kept (nk : Int) (key : Term) (arg : SetupValue) =
  if key_words_by_value nk then return () else llvm_points_to arg (llvm_term key);

/*
 * The bounds record { i32, i32 } (First, Last) of Key_Words' and
 * Round_Keys' fat pointers. After llvm-link the two types are one, named
 * after the first the linker met.
 */
let bounds_t = llvm_alias "foundation_spark__aes__spec__types__key_words_BOUNDS";
let bounds (first : Term) (last : Term) = do {
  p <- llvm_alloc_readonly bounds_t;
  llvm_points_to p (llvm_struct_value [llvm_term first, llvm_term last]);
  return p;
};

/*
 * The bounds of a slice: GNAT builds them in a stack temporary of the
 * caller, writable and 1-byte aligned (alloca ..., align 1), so the
 * record is allocated writable and with alignment 1: an override's
 * read-only or 4-byte aligned allocation does not match it. The contract
 * states it unchanged after the call.
 */
let slice_bounds (first : Term) (last : Term) = do {
  p <- llvm_alloc_aligned 1 bounds_t;
  llvm_points_to p (llvm_struct_value [llvm_term first, llvm_term last]);
  return p;
};

/*
 * The secondary stack: secondary_stack, ss_at and the rest
 * (secondary_stack.saw).
 */
include "secondary_stack.saw";

/*
 * llvm_verify of one spec subprogram (its LLVM symbol) against a Cryptol
 * term, with the overrides given and the proof tactic named, timed, and a
 * line check-saw.sh records: "RESULT proved <name> = <cryptol> [<tactic>]".
 */
let verify_spec name overrides contract tactic tactic_name cryptol = do {
  result <- time (llvm_verify aes_spec (spec_symbol name) overrides false contract tactic);
  print (str_concat (str_concat (str_concat (str_concat (str_concat "RESULT proved " name) " = ") cryptol) " [") (str_concat tactic_name "]"));
  return result;
};

/*
 * The same, without the RESULT line: for the members of a group of proofs
 * that one RESULTS line reports (an exhaustive proof, value by value).
 */
let verify_quiet name overrides contract tactic =
  llvm_verify aes_spec (spec_symbol name) overrides false contract tactic;

/*
 * " a b c" of ["a", "b", "c"], for the tactics' names.
 */
rec names (xs : [String]) : String =
  if null xs then "" else str_concat (str_concat " " (head xs)) (names (tail xs));

/*
 * "RESULTS <n> proved <name> = <cryptol> [<tactic>]": n proofs, recorded
 * as one line. check-saw.sh counts n against SAW's "Proof succeeded!".
 */
let print_results (n : Int) name cryptol tactic_name =
  print (str_concat (str_concat (str_concat (str_concat (str_concat (str_concat
    (str_concat "RESULTS " (show n)) " proved ") name) " = ") cryptol) " [") (str_concat tactic_name "]"));

/* --- contracts ------------------------------------------------------------ */

/*
 * function F (B : Byte) return Byte, and the same returning a Boolean
 * (i8 0 or 1).
 */
let byte_to_byte_contract (f : Term) = do {
  b <- llvm_fresh_var "b" byte_t;
  llvm_execute_func [llvm_term b];
  llvm_return (llvm_term {{ f b }});
};

/*
 * function F (B, C : Byte) return R.
 */
let byte_byte_contract (f : Term) = do {
  b <- llvm_fresh_var "b" byte_t;
  c <- llvm_fresh_var "c" byte_t;
  llvm_execute_func [llvm_term b, llvm_term c];
  llvm_return (llvm_term {{ f b c }});
};

/*
 * function F (Bs : Block) return Block, F (S : AESWord) return AESWord,
 * F (A, B : AESWord) return AESWord, F (Bs, W : Block) return Block:
 * constrained arrays by value.
 */
let block_contract (f : Term) = do {
  bs <- llvm_fresh_var "bs" block_t;
  llvm_execute_func [llvm_term bs];
  llvm_return (llvm_term {{ f bs }});
};
let word_contract (f : Term) = do {
  s <- llvm_fresh_var "s" word_t;
  llvm_execute_func [llvm_term s];
  llvm_return (llvm_term {{ f s }});
};
let word_word_contract (f : Term) = do {
  a <- llvm_fresh_var "a" word_t;
  b <- llvm_fresh_var "b" word_t;
  llvm_execute_func [llvm_term a, llvm_term b];
  llvm_return (llvm_term {{ f a b }});
};
let block_block_contract (f : Term) = do {
  bs <- llvm_fresh_var "bs" block_t;
  w <- llvm_fresh_var "w" block_t;
  llvm_execute_func [llvm_term bs, llvm_term w];
  llvm_return (llvm_term {{ f bs w }});
};

/*
 * function F (K : Key_Size) return Positive (Key_Size: 128 | 192 | 256):
 * AES.Spec.Types' Nk and Nr, as aes_impl_common.saw states them. They
 * are Static; the instances read them as constants, and nothing in
 * the spec module calls them, so their symbols may not be emitted.
 */
let key_size_contract (f : Term) = do {
  k <- llvm_fresh_var "k" (llvm_int 32);
  llvm_precond {{ k == 128 \/ k == 192 \/ k == 256 }};
  llvm_execute_func [llvm_term k];
  llvm_return (llvm_term {{ f k }});
};

/*
 * function Foldl_Take (Z : Block; Xs : Round_Keys; N : Integer) return
 * Block of Spec.Cipher's instances of the prelude's Folds (Round_Folds,
 * InvRound_Folds, InvRound_Prime_Folds), Xs of length M: Cryptol's
 * foldl f z (take`{N} xs) over [M]Block.
 *
 * Foldl_Round (Z, Xs) calls Round_Folds.Foldl (Z, Xs), which
 * calls Foldl_Take (Z, Xs, Xs'Length), which recurses on N with the same
 * Xs (the prelude's fold recurses from the last element). So the
 * recursion, and these lemmas, are Foldl_Take's, at the lengths M that
 * Cipher, InvCipher and InvCipher' fold (Nr - 1 = 9, 11, 13), one per N
 * in 0 .. M; SAW executes Foldl_Round and Foldl.
 *
 * Xs is a slice of the round keys: its fat pointer's data points to its
 * first element and its bounds are {First, First + M - 1}, First
 * symbolic, 1 <= First <= 15 - M. The data is allocated writable, and
 * stated unchanged after the call. Where the bounds are depends on the
 * caller (GNAT-LLVM 27, 2026-10-21), so the lemmas come in two kinds
 * (ro):
 *  - Cipher passes W (1 .. Nr - 1) of an instance, whose Nr is a
 *    constant: the bounds {1, Nr - 1} are a constant global, read-only
 *    (ro = true);
 *  - InvCipher and InvCipher' pass the reversed keys, on the secondary
 *    stack with their bounds {1, M}: writable (ro = false), which a
 *    read-only allocation does not match, allocated with alignment 1 as
 *    slice_bounds says, and stated unchanged.
 */
let foldl_take_contract_rhs (ro : Bool) (m : Int) (n : Int) (rhs : Term) = do {
  z <- llvm_fresh_var "z" block_t;
  xs <- llvm_fresh_var "xs" (llvm_array m block_t);
  xsp <- llvm_alloc (llvm_array m block_t);
  llvm_points_to xsp (llvm_term xs);
  first <- llvm_fresh_var "first" (llvm_int 32);
  llvm_precond {{ first >= 1 /\ first <= 15 - `m }};
  xsb <- if ro then bounds first {{ first + `m - 1 }} else slice_bounds first {{ first + `m - 1 }};
  llvm_execute_func [llvm_term z, llvm_struct_value [xsp, xsb], llvm_term {{ `n : [32] }}];
  llvm_points_to xsp (llvm_term xs);
  if ro then return ()
  else llvm_points_to xsb (llvm_struct_value [llvm_term first, llvm_term {{ first + `m - 1 }}]);
  llvm_return (llvm_term {{ rhs z xs }});
};
let foldl_take_contract (ro : Bool) (m : Int) (n : Int) (f : Term) =
  foldl_take_contract_rhs ro m n {{ \(z : [16][8]) (xs : [m][16][8]) -> foldl f z (take`{n} xs) }};

/*
 * The fold lemmas at one length M, one per N in n .. stop, each with the
 * round's lemma and the lemma at N - 1 as the overrides for its calls, by
 * z3 with the round (named cry in the Cryptol) uninterpreted. Returns the
 * lemma at N = stop (stop = M: the one Foldl_Round's callers reach).
 */
rec foldl_takes (ro : Bool) (name : String) (round : LLVMSpec) (f : Term) (cry : String) (m : Int) (stop : Int) (n : Int) (prev : [LLVMSpec]) : TopLevel LLVMSpec = do {
  lemma <- verify_spec name (concat prev [round]) (foldl_take_contract ro m n f)
             (w4_unint_z3 [cry]) (str_concat "w4_unint_z3 " cry)
             (str_concat (str_concat (str_concat (str_concat (str_concat "M = " (show m)) ", N = ") (show n))
                                     ": foldl Cipher::") cry);
  if eval_bool {{ `n == `stop }} then return lemma
  else foldl_takes ro name round f cry m stop (eval_int {{ `n + 1 : [32] }}) [lemma];
};

/*
 * The fold lemmas for one round function, with read-only bounds or not
 * (ro): at M = 9, 11 and 13, each the lemma at N = M. Returns the three.
 */
let foldls (ro : Bool) (name : String) (round : LLVMSpec) (f : Term) (cry : String) = do {
  l9 <- foldl_takes ro name round f cry 9 9 0 [];
  l11 <- foldl_takes ro name round f cry 11 11 0 [];
  l13 <- foldl_takes ro name round f cry 13 13 0 [];
  return [l9, l11, l13];
};

/*
 * The bytes InvCipher and InvCipher' take on the secondary stack for the
 * reversed round keys W (1 .. Nr - 1), between their mark and its
 * release: a bounds record, then nr - 1 blocks.
 */
let rv_size (nr : Int) = ss_size 8 (eval_int {{ 16 * (`nr - 1) : [64] }});

/*
 * function Cipher (W : Round_Keys; Input : Block) return Block of the
 * instance with Nr = nr (and InvCipher, InvCipher'): W, of the instance's
 * constrained Round_Keys (0 .. Nr), is a pointer to the nr + 1 round keys,
 * with no bounds, writable and stated unchanged (the fold lemmas take a
 * writable slice, and Main's Encrypt and Decrypt pass the round keys
 * KeyExpansion leaves in a stack temporary). With ss, the secondary
 * stack is set up empty first (InvCipher and InvCipher' use it): they
 * mark it, reverse ws onto it, and release the mark, so it is left empty,
 * its High_Water_Mark rv_size nr (Decrypt then states it). f is the
 * Cryptol at that size.
 */
let spec_cipher_contract_ss (ss : Bool) (nr : Int) (f : Term) = do {
  stack <- if ss then secondary_stack else return llvm_null;
  w <- llvm_fresh_var "w" (llvm_array (eval_int {{ `nr + 1 : [32] }}) block_t);
  wp <- llvm_alloc (llvm_array (eval_int {{ `nr + 1 : [32] }}) block_t);
  llvm_points_to wp (llvm_term w);
  input <- llvm_fresh_var "input" block_t;
  llvm_execute_func [wp, llvm_term input];
  if ss then ss_post_hwm stack 0 (rv_size nr) else return ();
  llvm_points_to wp (llvm_term w);
  llvm_return (llvm_term {{ f w input }});
};
let spec_cipher_contract = spec_cipher_contract_ss false;

/*
 * function Reverse_Keys (Xs : Round_Keys) return Round_Keys, at length m
 * with bounds {1, m} (InvCipher's W (1 .. Nr - 1)): the result is on the
 * secondary stack, its bounds then its data.
 */
let reverse_keys_contract (m : Int) = do {
  stack <- secondary_stack;
  xs <- llvm_fresh_var "xs" (llvm_array m block_t);
  xsp <- llvm_alloc_readonly (llvm_array m block_t);
  llvm_points_to xsp (llvm_term xs);
  xsb <- bounds {{ 1 : [32] }} {{ `m : [32] }};
  llvm_execute_func [llvm_struct_value [xsp, xsb]];
  llvm_points_to_untyped (ss_at stack 0) (llvm_struct_value [llvm_term {{ 1 : [32] }}, llvm_term {{ `m : [32] }}]);
  llvm_points_to_untyped (ss_at stack 8) (llvm_term {{ reverse xs }});
  llvm_return (llvm_struct_value [ss_at stack 8, ss_at stack 0]);
};

/*
 * function KeyExpansion (Key : Key_Words) return Round_Keys of the
 * instance at key size k: Key as in w_contract; the result, of the
 * constrained Round_Keys (0 .. Nr), nr + 1 round keys, is written
 * through the pointer the caller passes first (sret), not on the
 * secondary stack, as a K-explicit KeyExpansion's would be.
 */
let keyexpansion_contract (k : Int) (nk : Int) (nr : Int) = do {
  (key, keyarg) <- key_words_arg nk;
  ret <- llvm_alloc (llvm_array (eval_int {{ `nr + 1 : [32] }}) block_t);
  llvm_execute_func [ret, keyarg];
  key_words_kept nk key keyarg;
  llvm_points_to ret (llvm_term {{ KeyExpansion`{k} key }});
};

/*
 * function W (Key : Key_Words; I : Word_Index) return AESWord of the
 * instance at key size k (nk key words), at index i: Key is passed as
 * key_words_arg says (by value at k = 128, else a writable pointer,
 * stated unchanged: Main's Encrypt passes the key words Split_Key leaves
 * in a stack temporary). W's recursive calls pass the same Key, so each
 * lemma's Key is its caller's.
 *
 * The Cryptol is KeyExpansion.cry's w @ i, the element i of the expanded
 * key in KeyExpansion's where clause [FIPS-PUB-197 Section 5.2]. w is
 * local to KeyExpansion, so it is read back from KeyExpansion's result,
 * of which it is the words: KeyExpansion key = split (split (join (join
 * w))), so w = groupBy`{4} (join (KeyExpansion key)).
 */
let w_contract (k : Int) (nk : Int) (i : Int) (key_of : Term) = do {
  (key, keyarg) <- key_words_arg nk;
  llvm_execute_func [keyarg, llvm_term {{ `i : [32] }}];
  key_words_kept nk key keyarg;
  llvm_return (llvm_term {{ (groupBy`{4} (join (KeyExpansion`{k} (key_of key)))) @ (`i : [32]) }});
};

/*
 * The W lemmas at key size k, one per index i .. last, never unfolding
 * W's recursion: the lemma at I has the lemmas at the nk indices below it
 * (window) as the overrides for its two recursive calls, at I - 1 and
 * I - Nk (SAW applies the one whose index matches), and the leaves'
 * (RotWord's, SubWord's, "xor"'s; the instance reads Nk as a constant)
 * for its other calls. z3 with
 * SubWord uninterpreted: the Cryptol's w @ i, evaluated, is then
 * w @ (i - Nk) ^ SubWord (RotWord (w @ (i - 1))) ^ Rcon @ (i / Nk) (or
 * the case that applies) over the same terms as the overrides'. Returns
 * all the lemmas, those in all first.
 */
rec w_lemmas (leaves : [LLVMSpec]) (k : Int) (nk : Int) (last : Int) (i : Int) (window : [LLVMSpec]) (all : [LLVMSpec]) : TopLevel [LLVMSpec] = do {
  lemma <- verify_spec (instance_symbol k "w") (concat window leaves)
             (w_contract k nk i {{ \(key : [nk][4][8]) -> key }}) (w4_unint_z3 ["SubWord"]) "w4_unint_z3 SubWord"
             (str_concat (str_concat (str_concat (str_concat "K = " (show k)) ", I = ") (show i))
                ": (groupBy`{4} (join (KeyExpansion::KeyExpansion`{K} key))) @ I (KeyExpansion's w @ i)");
  let len = length window;
  let next = if eval_bool {{ (`len : Integer) == `nk }} then concat (tail window) [lemma]
             else concat window [lemma];
  if eval_bool {{ `i == (`last : Integer) }} then return (concat all [lemma])
  else w_lemmas leaves k nk last (eval_int {{ `i + 1 : [32] }}) next (concat all [lemma]);
};

/*
 * function F (A : Byte; P : Poly) return R, and function Affine (B :
 * Byte) return Byte, at one concrete byte a and the modulus
 * SBoxPolynomial (the exhaustive proofs).
 */
let pgcd_contract (a : Term) = do {
  llvm_execute_func [llvm_term a, llvm_term {{ zext SBoxPolynomial : [16] }}];
  llvm_return (llvm_term {{ [ zext p | p <- pgcd`{7, 8} a SBoxPolynomial ] : [5][16] }});
};
let inverse_contract (a : Term) = do {
  llvm_execute_func [llvm_term a, llvm_term {{ zext SBoxPolynomial : [16] }}];
  llvm_return (llvm_term {{ inverse a SBoxPolynomial }});
};
let affine_contract (b : Term) (f : Term) = do {
  llvm_execute_func [llvm_term b];
  llvm_return (llvm_term {{ f b }});
};

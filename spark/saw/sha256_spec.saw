/*
 * llvm_verify of the SPARK SHA-256 spec layer (the ghost functions of
 * Foundation_Spark.SHA2.SHA256, the SHA-256 instance of the generic
 * spark/src/sha2/foundation_spark-sha2-main.ads) against NSA's Cryptol:
 * M4.4 (#59): the compression function, the padding at the twelve message
 * lengths of M4.3's Hash proofs, and the hash at nine of them (all twelve
 * with SAW_LONG=1); and the HMAC-SHA-256 spec layer, HMAC.SHA256's
 * HMAC_init and HMAC, at M4.3's seven (key, text) lengths
 * (sha256_spec_hmac.saw).
 * sha256_spec_common.saw has the shared parts; the lemmas are in
 * sha256_spec_step.saw (the compression function), sha256_spec_pad.saw
 * (Pad and what it calls) and sha256_spec_hash.saw (Hash and the
 * recursions it calls).
 *
 * Main.cry's `step` (Main.cry:67) holds the message schedule W, the round
 * step3 and its T1 and T2 as local definitions, which cannot be named
 * from outside it. The spec's W, T1, T2, Step3 and Foldl_Step3 are proved
 * against saw/SHA256Step.cry, our copy of those locals at SHA-256, lifted
 * out of `step`; the spec's Step is proved against NSA's `step` itself
 * (saw/SHA256Main.cry, as sha256_impl.saw uses it), with Foldl_Step3's
 * lemma and "+"'s as the overrides: that proof is what ties the copies to
 * Main.cry.
 *
 * The recursions are never unfolded: W (Main.cry: W@t = sigma_1 (W@(t-2))
 * + W@(t-7) + sigma_0 (W@(t-15)) + W@(t-16)) one index t at a time, 64
 * lemmas, each with the lemmas below it as the overrides for its four
 * recursive calls; Foldl_Step3 (foldl step3 H [0 ..< N]) one N at a
 * time, 65 lemmas. T1 and Step3 take the round t and are proved at each,
 * 64 lemmas apiece. To_Bits, Word_Of and Foldl_Step likewise, one width,
 * count or block count at a time.
 *
 * No SAW proof of hash over bytes (#67 item 4; README "SAW", "What SAW
 * proves on its own, in place, or not at all"): SHA256_Bytes.Hash_Bytes is
 * not a Cryptol declaration. It is the spec's Hash on the bits of a byte
 * array, proved equal to it by gnatprove (Lemma_Hash_Bytes). The
 * end-to-end claim a SAW proof of it would carry, SHA256_Stream.Hash on
 * bytes = Cryptol hash, is already a SAW result of the implementation
 * layer (sha256_impl.saw), at 12 lengths. A SAW proof of Hash_Bytes would
 * sit between two things already joined.
 */

include "sha256_spec_common.saw";

/* --- the compression function -------------------------------------------- */

include "sha256_spec_step.saw";

/* --- Pad and Hash, in a load with lax arithmetic --------------------------- */

/*
 * In the module's load with lax arithmetic (sha256_spec_common.saw):
 * Pad's lemmas, and Hash's, which rest on them, with the compression
 * function's lemmas proved again in it for Hash's overrides; their
 * RESULT lines say "(lax arithmetic module)".
 */
let verify_spec = verify_spec_lax;
include "sha256_spec_step.saw";
include "sha256_spec_pad.saw";
include "sha256_spec_hash.saw";

/*
 * The options check-saw.sh sets: saw_long (SAW_LONG=1) adds the long
 * proofs.
 */
include "obj/options.saw";

/*
 * Word_Of's and Foldl_Step's lemmas for padded messages of 1 and 2
 * blocks, and, with saw_long, of 3 and 4. By default Hash is proved at
 * the lengths that pad to 1 or 2 blocks (0, 1, 55, 56, 63, 64, 65, 100
 * and 119 bytes); with saw_long also at 120, 128 and 200 bytes (3 and 4
 * blocks): each Word_Of lemma, First symbolic, takes time that grows
 * with the padded message's length (yices; z3 takes half again as long),
 * and the 66 lemmas for 1536 and 2048 bits are most of the long run's
 * cost (results.txt has each one's time). Pad is proved at all twelve
 * lengths in either case. Without saw_long, the 3- and 4-block names are
 * bound to the 2-block lemmas, and never used.
 */
i_word_of_1 <- word_of_lemmas 512 0 [];
i_word_of_2 <- word_of_lemmas 1024 0 [];
i_foldl_step_1 <- foldl_step_lemmas 1 0 [];
i_foldl_step_2 <- foldl_step_lemmas 2 0 [];
i_word_of_3 <- if saw_long then word_of_lemmas 1536 0 [] else return i_word_of_2;
i_word_of_4 <- if saw_long then word_of_lemmas 2048 0 [] else return i_word_of_2;
i_foldl_step_3 <- if saw_long then foldl_step_lemmas 3 0 [] else return i_foldl_step_2;
i_foldl_step_4 <- if saw_long then foldl_step_lemmas 4 0 [] else return i_foldl_step_2;
let word_of_for (nb : Int) =
  if eval_bool {{ `nb == (1 : Integer) }} then i_word_of_1
  else if eval_bool {{ `nb == (2 : Integer) }} then i_word_of_2
  else if eval_bool {{ `nb == (3 : Integer) }} then i_word_of_3
  else i_word_of_4;
let foldl_step_for (nb : Int) =
  if eval_bool {{ `nb == (1 : Integer) }} then i_foldl_step_1
  else if eval_bool {{ `nb == (2 : Integer) }} then i_foldl_step_2
  else if eval_bool {{ `nb == (3 : Integer) }} then i_foldl_step_3
  else i_foldl_step_4;

/*
 * Parse on its own (#67 item 3): Preprocessing.cry's parse`{32, N} at the
 * padded lengths Hash uses, 1 and 2 blocks, and 3 and 4 with saw_long,
 * with Word_Of's lemma at 32 for that length as the override
 * (sha256_spec_hash.saw's parse_contract). Hash still executes Parse
 * within its own proofs rather than take these as overrides: there Parse's
 * message is Pad's result, on the secondary stack above Pad's own
 * temporaries, not an allocation of its own.
 */
verify_parse 1 i_word_of_1;
verify_parse 2 i_word_of_2;
if saw_long then do {
  verify_parse 3 i_word_of_3;
  verify_parse 4 i_word_of_4;
  return ();
} else return ();

/*
 * Pad, and Hash where the padded message has 1 or 2 blocks (3 or 4 too
 * with saw_long), at each length, by groups of the same k (Zero's lemma
 * and To_Bits' chain are proved once per group). Hash at 0 bytes has no
 * symbolic input: the overrides' step is evaluated on constants, so the
 * Cryptol's must be too, and nothing is left uninterpreted (as
 * sha256_impl.saw's Hash at 0).
 */
let verify_pad_hash_group (ls : [Int]) = do {
  let k = small_k (head ls);
  z <- verify_zero k;
  tb <- to_bits_lemmas (ss_size 32 k) (eval_int {{ 32 + `k : [64] }}) 0 [];
  for ls (\l -> do {
    sk <- verify_small_k l;
    pad_l <- verify_spec "sha256__pad" [sk, z, tb] (pad_contract l) z3 "z3"
               (str_concat (str_concat "l = " (show l)) ": Preprocessing::pad`{512, 32, l, (l + 65) %^ 512}");
    let nb = eval_int {{ (`l + 65 + 511) / 512 : [64] }};
    if (if saw_long then false else eval_bool {{ `nb > (2 : Integer) }}) then return ()
    else do {
      verify_spec "sha256__hash"
        [pad_l, word_of_for nb, foldl_step_for nb]
        (hash_contract l)
        (if eval_bool {{ `l == (0 : Integer) }} then z3 else w4_unint_z3 ["step"])
        (if eval_bool {{ `l == (0 : Integer) }} then "z3, nothing uninterpreted (no symbolic input)" else "w4_unint_z3 step")
        (str_concat (str_concat "l = " (show l)) ": SHA256Main::hash`{l} (Main.cry's hash at SHA-256)");
      return ();
    };
  });
};
for pad_length_groups verify_pad_hash_group;

/* --- HMAC-SHA-256, in the same load ---------------------------------------- */

/*
 * HMAC.SHA256's HMAC_init and HMAC at M4.3's (key, text) lengths in
 * bytes (sha256_spec_hmac.saw), each with the Hash lemmas its calls need,
 * proved at the secondary stack's base for each call (each base costs a
 * To_Bits chain, about 70 s). By default one length per case of
 * HMAC_init: (32, 3) for k < B, (64, 32) for k = B, (65, 3) for k > B;
 * with saw_long also (0, 0), (32, 32), (64, 3) and (100, 32).
 */
include "sha256_spec_hmac.saw";
verify_hmac 32 3;
verify_hmac 64 32;
verify_hmac 65 3;
if saw_long then do {
  verify_hmac 0 0;
  verify_hmac 32 32;
  verify_hmac 64 3;
  verify_hmac 100 32;
  return ();
} else return ();

/*
 * The local definitions of algorithms/SHA2/Main.cry's `step` (Main.cry:67)
 * at SHA-256's parameters, lifted out of `step` so that they can be named,
 * for spark/saw/sha256_spec.saw (M4.4, #59). This is ours, not NSA's: it
 * copies `step`'s `where` clause, text for text, with the block `M` that
 * the locals close over made an explicit first argument, and with
 * SHA256.cry's parameters (Klen = 64, w = 32, K = K_256 and the
 * SHA-224/256 SIGMA and sigma, SHA256.cry:16-28) in the place of Main's.
 *
 * Main.cry's W, step3, T1 and T2 cannot be named from outside `step`, so
 * the spec layer's W, T1, T2, Step3 and Foldl_Step3, which mirror them,
 * are proved against these; the spec's Step is then proved against NSA's
 * `step` itself (through saw/SHA256Main.cry), with Foldl_Step3's lemma as
 * the override, which is what ties these copies to the NSA definitions.
 */
module SHA256Step where

import algorithms::SHA2::Functions ( Ch
                                   , Maj
                                   , SIGMA_256_0
                                   , SIGMA_256_1
                                   , sigma_256_0
                                   , sigma_256_1
                                   , K_256)

type w = 32
type Klen = 64

K = K_256
SIGMA_0 = SIGMA_256_0
SIGMA_1 = SIGMA_256_1
sigma_0 = sigma_256_0
sigma_1 = sigma_256_1

/** `step`'s `W` (Main.cry:70), of the block M. */
Ws : [16][w] -> [Klen][w]
Ws M = W
  where
    W : [Klen][w]  // Step 1 [FIPS-PUB-180-4 Sections 6.2.2 and 6.4.2].
    W@t = if t <= 15 then M @ t
          else            sigma_1 (W@(t-2)) + W@(t-7) + sigma_0 (W@(t-15)) + W@(t-16)

/** `step3`'s `T1` (Main.cry:87), of the block M. */
T1 : [16][w] -> [8][w] -> Integer -> [w]
T1 M [a, b, c, d, e, f, g, h] t = h + SIGMA_1 e + Ch (e, f, g) + K@t + Ws M @ t

/** `step3`'s `T2` (Main.cry:88). */
T2 : [8][w] -> [w]
T2 [a, b, c, d, e, f, g, h] = SIGMA_0 a + Maj (a, b, c)

/** `step`'s `step3` (Main.cry:75), of the block M. */
step3 : [16][w] -> [8][w] -> Integer -> [8][w]
step3 M [a, b, c, d, e, f, g, h] t =
    [ T1 + T2
    , a
    , b
    , c
    , d + T1
    , e
    , f
    , g
    ]
   where
     T1 = h + SIGMA_1 e + Ch (e, f, g) + K@t + Ws M @ t
     T2 = SIGMA_0 a + Maj (a, b, c)

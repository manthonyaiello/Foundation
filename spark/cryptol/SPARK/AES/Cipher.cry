/*
 * The SPARK spec layer's round transformations and ciphers, checked
 * against algorithms/AES/Cipher.cry through Cryptol's FFI.
 *
 * The foreign functions are the C exports of the SPARK crate's FFI library
 * (spark/foundation_spark_ffi.gpr), which spark/scripts/check-ffi.sh links
 * here as Cipher.so. They have no Cryptol body on purpose (see GF28.cry).
 *
 * The domains are 2^32 (the column steps), 2^128 (one block) and 2^256 (a
 * block and a round key) or more (a key schedule and a block), so each
 * property is a :check, with the test count stated in
 * spark/cryptol/properties.txt. Cipher, InvCipher and InvCipher' are
 * checked at each key size k = 128, 192 and 256, through one SPARK export
 * each: Cryptol passes {k} to it as a leading size_t.
 *
 * The executable ciphers, AES.Impl.Encrypt_Block, Decrypt_Block and
 * Decrypt_Block_Prime, are exported too (spark_Encrypt_Block,
 * spark_Decrypt_Block and spark_Decrypt_Block_Prime, from
 * Foundation_Spark.FFI.AES_Impl) and checked against the same Cipher,
 * InvCipher and InvCipher'. Each is proved equal to its spec function, so
 * their samples check the spec's faithfulness too, and they carry the bulk
 * of the random testing at each key size; the spec's own ciphers run a
 * handful of tests each, enough to run their export path (spark/README.md,
 * "Targeted, not volume").
 *
 * algorithms::AES::Cipher declares Cipher and InvCipher foreign, with a
 * Cryptol body and a Rust library that this repository does not build.
 * check-ffi.sh fails if that library is ever loaded, so these properties
 * compare SPARK with the Cryptol bodies.
 */
module SPARK::AES::Cipher where

import algorithms::AES::Types
import algorithms::AES::Cipher
import algorithms::AES::KeyExpansion (KeyExpansion)

/** Foundation_Spark.FFI.AES_Cipher.SubBytes: Cipher.cry's SubBytes. */
foreign spark_SubBytes : Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvSubBytes: Cipher.cry's InvSubBytes. */
foreign spark_InvSubBytes : Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.ShiftRows: Cipher.cry's ShiftRows. */
foreign spark_ShiftRows : Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvShiftRows: Cipher.cry's InvShiftRows. */
foreign spark_InvShiftRows : Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.MixColumnsStep: Cipher.cry's MixColumnsStep. */
foreign spark_MixColumnsStep : AESWord -> AESWord

/** Foundation_Spark.FFI.AES_Cipher.MixColumns: Cipher.cry's MixColumns. */
foreign spark_MixColumns : Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvMixColumnsStep: Cipher.cry's InvMixColumnsStep. */
foreign spark_InvMixColumnsStep : AESWord -> AESWord

/** Foundation_Spark.FFI.AES_Cipher.InvMixColumns: Cipher.cry's InvMixColumns. */
foreign spark_InvMixColumns : Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.AddRoundKey: Cipher.cry's AddRoundKey. */
foreign spark_AddRoundKey : Block -> Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.Round: Cipher.cry's Round. */
foreign spark_Round : Block -> Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvRound: Cipher.cry's InvRound. */
foreign spark_InvRound : Block -> Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvRound_Prime: Cipher.cry's InvRound'. */
foreign spark_InvRound_Prime : Block -> Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.Cipher: Cipher.cry's Cipher. */
foreign spark_Cipher : {k} (Key k) => [Nr k + 1]Block -> Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvCipher: Cipher.cry's InvCipher. */
foreign spark_InvCipher : {k} (Key k) => [Nr k + 1]Block -> Block -> Block

/** Foundation_Spark.FFI.AES_Cipher.InvCipher_Prime: Cipher.cry's InvCipher'. */
foreign spark_InvCipher_Prime : {k} (Key k) => [Nr k + 1]Block -> Block -> Block

/**
 * Foundation_Spark.FFI.AES_Impl.Encrypt_Block: the executable
 * AES.Impl.Encrypt_Block, proved equal to the spec's Cipher (Cipher.cry's
 * Cipher).
 */
foreign spark_Encrypt_Block : {k} (Key k) => [Nr k + 1]Block -> Block -> Block

/**
 * Foundation_Spark.FFI.AES_Impl.Decrypt_Block: the executable
 * AES.Impl.Decrypt_Block, proved equal to the spec's InvCipher (Cipher.cry's
 * InvCipher).
 */
foreign spark_Decrypt_Block : {k} (Key k) => [Nr k + 1]Block -> Block -> Block

/**
 * Foundation_Spark.FFI.AES_Impl.Decrypt_Block_Prime: the executable
 * AES.Impl.Decrypt_Block_Prime, proved equal to the spec's InvCipher_Prime
 * (Cipher.cry's InvCipher').
 */
foreign spark_Decrypt_Block_Prime : {k} (Key k) => [Nr k + 1]Block -> Block -> Block

/** The SPARK SubBytes is Cipher.cry's SubBytes. */
prop_SubBytes : Block -> Bit
property prop_SubBytes bs = spark_SubBytes bs == SubBytes bs

/** The SPARK InvSubBytes is Cipher.cry's InvSubBytes. */
prop_InvSubBytes : Block -> Bit
property prop_InvSubBytes bs = spark_InvSubBytes bs == InvSubBytes bs

/** The SPARK ShiftRows is Cipher.cry's ShiftRows. */
prop_ShiftRows : Block -> Bit
property prop_ShiftRows bs = spark_ShiftRows bs == ShiftRows bs

/** The SPARK InvShiftRows is Cipher.cry's InvShiftRows. */
prop_InvShiftRows : Block -> Bit
property prop_InvShiftRows bs = spark_InvShiftRows bs == InvShiftRows bs

/** The SPARK MixColumnsStep is Cipher.cry's MixColumnsStep. */
prop_MixColumnsStep : AESWord -> Bit
property prop_MixColumnsStep s = spark_MixColumnsStep s == MixColumnsStep s

/** The SPARK MixColumns is Cipher.cry's MixColumns. */
prop_MixColumns : Block -> Bit
property prop_MixColumns bs = spark_MixColumns bs == MixColumns bs

/** The SPARK InvMixColumnsStep is Cipher.cry's InvMixColumnsStep. */
prop_InvMixColumnsStep : AESWord -> Bit
property prop_InvMixColumnsStep s = spark_InvMixColumnsStep s == InvMixColumnsStep s

/** The SPARK InvMixColumns is Cipher.cry's InvMixColumns. */
prop_InvMixColumns : Block -> Bit
property prop_InvMixColumns bs = spark_InvMixColumns bs == InvMixColumns bs

/** The SPARK AddRoundKey is Cipher.cry's AddRoundKey. */
prop_AddRoundKey : Block -> Block -> Bit
property prop_AddRoundKey bs w = spark_AddRoundKey bs w == AddRoundKey bs w

/** The SPARK Round is Cipher.cry's Round. */
prop_Round : Block -> Block -> Bit
property prop_Round xs ki = spark_Round xs ki == Round xs ki

/** The SPARK InvRound is Cipher.cry's InvRound. */
prop_InvRound : Block -> Block -> Bit
property prop_InvRound xs ki = spark_InvRound xs ki == InvRound xs ki

/** The SPARK InvRound' is Cipher.cry's InvRound'. */
prop_InvRound' : Block -> Block -> Bit
property prop_InvRound' xs ki = spark_InvRound_Prime xs ki == InvRound' xs ki

/**
 * The SPARK Cipher, InvCipher and InvCipher' are Cipher.cry's at key size
 * k, on random round keys (any [Nr k + 1]Block, as the Cryptol types them,
 * not only key schedules) and random blocks.
 */
prop_Cipher : {k} (Key k) => [Nr k + 1]Block -> Block -> Bit
prop_Cipher w in = spark_Cipher`{k} w in == Cipher`{k} w in

/** The SPARK InvCipher is Cipher.cry's, at key size k. */
prop_InvCipher : {k} (Key k) => [Nr k + 1]Block -> Block -> Bit
prop_InvCipher w in = spark_InvCipher`{k} w in == InvCipher`{k} w in

/** The SPARK InvCipher' is Cipher.cry's, at key size k. */
prop_InvCipher' : {k} (Key k) => [Nr k + 1]Block -> Block -> Bit
prop_InvCipher' w in = spark_InvCipher_Prime`{k} w in == InvCipher'`{k} w in

/** prop_Cipher at k = 128. */
prop_Cipher128 : [Nr 128 + 1]Block -> Block -> Bit
property prop_Cipher128 = prop_Cipher`{128}

/** prop_Cipher at k = 192. */
prop_Cipher192 : [Nr 192 + 1]Block -> Block -> Bit
property prop_Cipher192 = prop_Cipher`{192}

/** prop_Cipher at k = 256. */
prop_Cipher256 : [Nr 256 + 1]Block -> Block -> Bit
property prop_Cipher256 = prop_Cipher`{256}

/** prop_InvCipher at k = 128. */
prop_InvCipher128 : [Nr 128 + 1]Block -> Block -> Bit
property prop_InvCipher128 = prop_InvCipher`{128}

/** prop_InvCipher at k = 192. */
prop_InvCipher192 : [Nr 192 + 1]Block -> Block -> Bit
property prop_InvCipher192 = prop_InvCipher`{192}

/** prop_InvCipher at k = 256. */
prop_InvCipher256 : [Nr 256 + 1]Block -> Block -> Bit
property prop_InvCipher256 = prop_InvCipher`{256}

/** prop_InvCipher' at k = 128. */
prop_InvCipher'128 : [Nr 128 + 1]Block -> Block -> Bit
property prop_InvCipher'128 = prop_InvCipher'`{128}

/** prop_InvCipher' at k = 192. */
prop_InvCipher'192 : [Nr 192 + 1]Block -> Block -> Bit
property prop_InvCipher'192 = prop_InvCipher'`{192}

/** prop_InvCipher' at k = 256. */
prop_InvCipher'256 : [Nr 256 + 1]Block -> Block -> Bit
property prop_InvCipher'256 = prop_InvCipher'`{256}

/**
 * algorithms/AES/Tests.cry's CipherExample [FIPS-PUB-197 Appendix B],
 * through the SPARK Cipher and InvCipher. The vectors are copied from
 * Tests.cry; the round keys are KeyExpansion`{128} of its key.
 */
property prop_CipherExample =
    spark_Cipher`{128}    key input == output
 /\ spark_InvCipher`{128} key output == input
  where
    input  = split 0x3243f6a8885a308d313198a2e0370734
    key    = KeyExpansion`{128} (split (split 0x2b7e151628aed2a6abf7158809cf4f3c))
    output = split 0x3925841d02dc09fbdc118597196a0b32

/**
 * The executable Encrypt_Block is Cipher.cry's Cipher at key size k, on
 * random round keys (any [Nr k + 1]Block, as for prop_Cipher) and random
 * blocks.
 */
prop_Encrypt_Block : {k} (Key k) => [Nr k + 1]Block -> Block -> Bit
prop_Encrypt_Block w in = spark_Encrypt_Block`{k} w in == Cipher`{k} w in

/** The executable Decrypt_Block is Cipher.cry's InvCipher, at key size k. */
prop_Decrypt_Block : {k} (Key k) => [Nr k + 1]Block -> Block -> Bit
prop_Decrypt_Block w in = spark_Decrypt_Block`{k} w in == InvCipher`{k} w in

/**
 * The executable Decrypt_Block_Prime is Cipher.cry's InvCipher', at key
 * size k.
 */
prop_Decrypt_Block_Prime : {k} (Key k) => [Nr k + 1]Block -> Block -> Bit
prop_Decrypt_Block_Prime w in =
  spark_Decrypt_Block_Prime`{k} w in == InvCipher'`{k} w in

/** prop_Encrypt_Block at k = 128. */
prop_Encrypt_Block128 : [Nr 128 + 1]Block -> Block -> Bit
property prop_Encrypt_Block128 = prop_Encrypt_Block`{128}

/** prop_Encrypt_Block at k = 192. */
prop_Encrypt_Block192 : [Nr 192 + 1]Block -> Block -> Bit
property prop_Encrypt_Block192 = prop_Encrypt_Block`{192}

/** prop_Encrypt_Block at k = 256. */
prop_Encrypt_Block256 : [Nr 256 + 1]Block -> Block -> Bit
property prop_Encrypt_Block256 = prop_Encrypt_Block`{256}

/** prop_Decrypt_Block at k = 128. */
prop_Decrypt_Block128 : [Nr 128 + 1]Block -> Block -> Bit
property prop_Decrypt_Block128 = prop_Decrypt_Block`{128}

/** prop_Decrypt_Block at k = 192. */
prop_Decrypt_Block192 : [Nr 192 + 1]Block -> Block -> Bit
property prop_Decrypt_Block192 = prop_Decrypt_Block`{192}

/** prop_Decrypt_Block at k = 256. */
prop_Decrypt_Block256 : [Nr 256 + 1]Block -> Block -> Bit
property prop_Decrypt_Block256 = prop_Decrypt_Block`{256}

/** prop_Decrypt_Block_Prime at k = 128. */
prop_Decrypt_Block_Prime128 : [Nr 128 + 1]Block -> Block -> Bit
property prop_Decrypt_Block_Prime128 = prop_Decrypt_Block_Prime`{128}

/** prop_Decrypt_Block_Prime at k = 192. */
prop_Decrypt_Block_Prime192 : [Nr 192 + 1]Block -> Block -> Bit
property prop_Decrypt_Block_Prime192 = prop_Decrypt_Block_Prime`{192}

/** prop_Decrypt_Block_Prime at k = 256. */
prop_Decrypt_Block_Prime256 : [Nr 256 + 1]Block -> Block -> Bit
property prop_Decrypt_Block_Prime256 = prop_Decrypt_Block_Prime`{256}

/**
 * Tests.cry's CipherExample [FIPS-PUB-197 Appendix B] through the
 * executable Encrypt_Block, Decrypt_Block and Decrypt_Block_Prime, as
 * prop_CipherExample does through the spec. The vectors are copied from
 * Tests.cry; the round keys are KeyExpansion`{128} of its key.
 */
property prop_Block_CipherExample =
    spark_Encrypt_Block`{128}       key input  == output
 /\ spark_Decrypt_Block`{128}       key output == input
 /\ spark_Decrypt_Block_Prime`{128} key output == input
  where
    input  = split 0x3243f6a8885a308d313198a2e0370734
    key    = KeyExpansion`{128} (split (split 0x2b7e151628aed2a6abf7158809cf4f3c))
    output = split 0x3925841d02dc09fbdc118597196a0b32

/**
 * Foundation_Spark.FFI.AES_Impl.Sub_Bytes: the executable AES.Impl.Sub_Bytes,
 * the S-box circuit on two words of eight byte lanes (issue #50), proved
 * equal to the spec's SubBytes.
 */
foreign spark_Impl_SubBytes : Block -> Block

/**
 * Foundation_Spark.FFI.AES_Impl.Inv_Sub_Bytes: the executable
 * AES.Impl.Inv_Sub_Bytes (issue #50), proved equal to the spec's
 * InvSubBytes.
 */
foreign spark_Impl_InvSubBytes : Block -> Block

/** The executable Sub_Bytes is Cipher.cry's SubBytes. */
prop_Impl_SubBytes : Block -> Bit
property prop_Impl_SubBytes bs = spark_Impl_SubBytes bs == SubBytes bs

/** The executable Inv_Sub_Bytes is Cipher.cry's InvSubBytes. */
prop_Impl_InvSubBytes : Block -> Bit
property prop_Impl_InvSubBytes bs = spark_Impl_InvSubBytes bs == InvSubBytes bs

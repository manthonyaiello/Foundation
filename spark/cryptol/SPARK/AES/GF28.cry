/*
 * The SPARK spec layer's GF(2^^8), checked against algorithms/AES/GF28.cry
 * through Cryptol's FFI (issue #4).
 *
 * The foreign functions below are the C exports of the SPARK crate's FFI
 * library (spark/foundation_spark_ffi.gpr): spark/scripts/check-ffi.sh links
 * that library here as GF28.so, which is where Cryptol looks for this
 * module's foreign implementations. They have no Cryptol body on purpose:
 * a body would be evaluated whenever the library is not loaded, and the
 * properties would compare the Cryptol with itself.
 *
 * Each property states that a SPARK function equals the NSA function it
 * mirrors, over the whole domain: check-ffi.sh runs both with :exhaust.
 */
module SPARK::AES::GF28 where

import algorithms::AES::GF28

/**
 * Foundation_Spark.FFI.AES_GF28.xTimes: the SPARK spec's xTimes
 * (algorithms/AES/GF28.cry, xTimes).
 */
foreign spark_xTimes : [8] -> [8]

/**
 * Foundation_Spark.FFI.AES_GF28.Dot: the SPARK spec's Dot
 * (algorithms/AES/GF28.cry, (•)).
 */
foreign spark_Dot : [8] -> [8] -> [8]

/**
 * The SPARK xTimes is GF28.cry's xTimes on every byte (256 tests).
 */
prop_xTimes : [8] -> Bit
property prop_xTimes b = spark_xTimes b == xTimes b

/**
 * The SPARK Dot is GF28.cry's (•) on every pair of bytes (65,536 tests).
 */
prop_Dot : [8] -> [8] -> Bit
property prop_Dot b c = spark_Dot b c == b • c

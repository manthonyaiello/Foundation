--  The constant-time harness (issue #50): a throughput benchmark and a
--  dudect-style timing test of the SPARK implementations, built from the
--  crate's sources at Alire's release optimization level, with the crate's
--  default runtime checks (no -gnatp). Not part of the library, not proved,
--  and not scanned by the proof, trust or docs gates. scripts/check-ct.sh
--  builds and runs it; README "Constant time" says what it shows.

project CT is

   --  The architecture, for ct_grind's Valgrind client requests:
   --  scripts/check-ct.sh passes -XCT_ARCH=$(uname -m).
   type Arch_Type is ("aarch64", "x86_64");
   Arch : Arch_Type := external ("CT_ARCH", "aarch64");

   for Source_Dirs use
     ("src", "src/arch-" & Arch,
      "../src", "../src/aes", "../src/sha2", "../src/hmac");
   for Object_Dir use "../obj/ct";
   for Exec_Dir use "../obj/ct";
   for Create_Missing_Dirs use "True";
   for Main use ("ct_bench.adb", "ct_dudect.adb", "ct_grind.adb");

   --  Alire's "release" profile: Optimization Performance (-O3 -gnatn),
   --  no debug info, default runtime checks, and its section switches.
   Release_Switches :=
     ("-O3", "-gnatn", "-ffunction-sections", "-fdata-sections",
      "-gnat2022", "-gnatW8");

   package Compiler is
      for Default_Switches ("Ada") use Release_Switches;
   end Compiler;

end CT;

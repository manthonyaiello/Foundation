# toolchain-pins.env -- the one record of the campaign's tool versions.
#
# Read by .github/actions/setup-alire-spark (CI: every spark-* job) and by
# scripts/bootstrap-x86_64.sh (the x86_64 instance), so the two cannot drift
# apart. Plain KEY=VALUE lines, no quotes and no expansions: the action copies
# them into $GITHUB_OUTPUT and $GITHUB_ENV as they are, and the bootstrap
# sources this file.
#
# The versions are the ones the campaign decided on (.claude/campaign/PLAN.md,
# "Decisions taken"): gnat_native 16.1.0 because sparklib ^16.1.0 needs
# GNAT 16, and gnatdoc_bin 26.0.0 as the generation that pairs with it. The
# set of proved checks and of doc warnings IS the gate, so an index update
# must not be able to change what CI accepts without a commit saying so.
#
# Every sha256 is that of the release asset, checked before it is unpacked.

# Alire, and the crates it installs.
ALR_VERSION=2.1.1
# alr-2.1.1-bin-x86_64-linux.zip (the bootstrap's download; CI's comes from
# alire-project/setup-alire).
ALR_X86_64_LINUX_SHA256=09c66bcd8c35dd4b97b72c3d9b76e44caa6964a2db35aba069f396f00f1f64c7
GNAT_NATIVE_VERSION=16.1.0
GPRBUILD_VERSION=26.0.1
GNATPROVE_VERSION=16.1.0
GNATDOC_VERSION=26.0.0

# Cryptol, the release build with solvers: its type checker will not start
# without z3. FFI enabled. x86_64 Linux only (no arm64 Linux release).
CRYPTOL_VERSION=3.6.0
CRYPTOL_TARBALL=cryptol-3.6.0-ubuntu-24.04-X64-with-solvers.tar.gz
CRYPTOL_SHA256=621860aa1dedc037e8fc8355bef3edf023e41e78efb7177146126f5a87309962

# SAW (E4), the release build with solvers. The sha256 was computed from the
# downloaded asset and matches the digest GitHub lists for it. The release's
# .sig is signed by key 07FC90D0C93F5F3B56354E1DCBF4BB4143DB4A3A, which
# neither keys.openpgp.org nor keyserver.ubuntu.com serves, so the sha256 is
# the pin (the bootstrap verifies the .sig too when given the key).
SAW_VERSION=1.6
SAW_TAG=v1.6
SAW_TARBALL=saw-1.6-ubuntu-24.04-X64-with-solvers.tar.gz
SAW_SHA256=0b25c8b32db8b4a7ec32d6700024af60bb2a0398ee350b630dd84ff377c938f7
SAW_SIGNING_KEY=07FC90D0C93F5F3B56354E1DCBF4BB4143DB4A3A

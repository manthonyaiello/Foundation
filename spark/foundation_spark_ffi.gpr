--  The FFI library (#4): the crate's sources, ghost code and assertions
--  enabled, as one shared, encapsulated, auto-initializing standalone
--  library that Cryptol loads by foreign. Built and used by
--  scripts/check-ffi.sh; see spark/README.md, "The FFI harness".
--
--  * Encapsulated: libgnat is linked in, so Cryptol's process needs no
--    GNAT runtime of its own.
--  * Auto-initializing: the library elaborates itself when it is loaded,
--    since Cryptol cannot call adainit.
--  * Ghost code enabled (-gnata turns on every assertion policy, Ghost
--    included): the spec layer is ghost, and here it has to execute.
--  * --no-undefined: the export units call the ghost shims by their
--    prefixed link names (Foundation_Spark.FFI). A name that does not
--    resolve fails the link here, not the first call from Cryptol.
--
--  Not a proof project: gnatprove reads foundation_spark.gpr.

with "config/foundation_spark_config.gpr";
with "sparklib";

project Foundation_Spark_FFI is

   for Source_Dirs use ("src/**", "config/");
   for Object_Dir use "obj/ffi/build";
   for Create_Missing_Dirs use "True";

   for Library_Name use "foundation_spark_ffi";
   for Library_Dir use "obj/ffi/lib";
   for Library_Kind use "relocatable";
   for Library_Standalone use "encapsulated";
   for Library_Auto_Init use "true";

   --  The export units (one per Cryptol module checked), the ghost shim
   --  units they call, and the parents those need. The shims must be
   --  listed: an export unit reaches its shims through link names only,
   --  not through a with clause, so nothing else brings them into the
   --  library.
   for Library_Interface use
     ("Foundation_Spark",
      "Foundation_Spark.FFI",
      "Foundation_Spark.AES",
      "Foundation_Spark.AES.Spec",
      "Foundation_Spark.AES.Spec.Types",
      "Foundation_Spark.AES.Spec.GF28",
      "Foundation_Spark.FFI.AES_GF28",
      "Foundation_Spark.FFI.AES_GF28_Exports",
      "Foundation_Spark.AES.Spec.SBox",
      "Foundation_Spark.AES.Spec.Cipher",
      "Foundation_Spark.AES.Spec.KeyExpansion",
      "Foundation_Spark.AES.Spec.Main",
      "Foundation_Spark.FFI.AES_Types",
      "Foundation_Spark.FFI.AES_SBox",
      "Foundation_Spark.FFI.AES_SBox_Exports",
      "Foundation_Spark.FFI.AES_Cipher",
      "Foundation_Spark.FFI.AES_Cipher_Exports",
      "Foundation_Spark.FFI.AES_KeyExpansion",
      "Foundation_Spark.FFI.AES_KeyExpansion_Exports",
      "Foundation_Spark.FFI.AES_Main",
      "Foundation_Spark.FFI.AES_Main_Exports",
      "Foundation_Spark.AES.Lemmas",
      "Foundation_Spark.AES.Impl",
      "Foundation_Spark.AES.Impl.Main",
      "Foundation_Spark.AES.Main_Lemmas",
      "Foundation_Spark.FFI.AES_Impl",
      "Foundation_Spark.SHA2",
      "Foundation_Spark.SHA2.Notation",
      "Foundation_Spark.SHA2.Functions",
      "Foundation_Spark.SHA2.Preprocessing",
      "Foundation_Spark.SHA2.Main",
      "Foundation_Spark.SHA2.SHA256",
      "Foundation_Spark.SHA2.SHA256_Bytes",
      "Foundation_Spark.SHA2.SHA256_Blocks",
      "Foundation_Spark.SHA2.SHA256_Stream",
      "Foundation_Spark.FFI.SHA2_Types",
      "Foundation_Spark.FFI.SHA2_Functions",
      "Foundation_Spark.FFI.SHA2_Functions_Exports",
      "Foundation_Spark.FFI.SHA2_Preprocessing",
      "Foundation_Spark.FFI.SHA2_Preprocessing_Exports",
      "Foundation_Spark.FFI.SHA2_SHA256",
      "Foundation_Spark.FFI.SHA2_SHA256_Exports",
      "Foundation_Spark.FFI.SHA2_SHA256_Stream",
      "Foundation_Spark.HMAC",
      "Foundation_Spark.HMAC.Main",
      "Foundation_Spark.HMAC.SHA256",
      "Foundation_Spark.HMAC.SHA256_Impl",
      "Foundation_Spark.FFI.HMAC_SHA256",
      "Foundation_Spark.FFI.HMAC_SHA256_Exports",
      "Foundation_Spark.FFI.HMAC_SHA256_Impl");

   for Library_Options use ("-Wl,--no-undefined");

   package Compiler is
      for Default_Switches ("Ada") use
        Foundation_Spark_Config.Ada_Compiler_Switches & ("-gnata");

      --  The executable implementations, and the units that export them,
      --  are built as a client builds them: ghost code and assertions
      --  ignored. They call no ghost code (each PR that added them checked
      --  that the crate builds and runs with ghost code ignored), and
      --  their contracts and invariants, executed, would run the ghost spec
      --  inside every Update: Models folds Step over the whole message so
      --  far, so the checks would grow with the square of the length; and
      --  AES.Impl's postconditions would run the ghost KeyExpansion, whose
      --  recursive W is exponential when executed. The
      --  check then runs the code that ships, and the ghost spec it is
      --  proved against runs only in the shims. No unit built with -gnata
      --  refers to their ghost entities, so nothing is left unresolved
      --  (--no-undefined).
      for Switches ("foundation_spark-aes-impl.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
      for Switches ("foundation_spark-aes-impl-main.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
      for Switches ("foundation_spark-ffi-aes_impl.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
      for Switches ("foundation_spark-sha2-sha256_stream.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
      for Switches ("foundation_spark-ffi-sha2_sha256_stream.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
      for Switches ("foundation_spark-hmac-sha256_impl.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
      for Switches ("foundation_spark-ffi-hmac_sha256_impl.adb") use
        Foundation_Spark_Config.Ada_Compiler_Switches;
   end Compiler;

end Foundation_Spark_FFI;
